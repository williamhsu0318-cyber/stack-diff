---
import Layout from '../layouts/Layout.astro';
import { buildComparisonData, type ToolSpec, type ComparisonData } from '../utils/specEngine';

export interface ToolItem {
  id: string;
  name: string;
  slug: string;
  category: string;
  tagline?: string;
  core_positioning?: string;
  pricing_model: string;
  starting_price: string;
  free_tier: boolean;
  best_for?: string;
  primary_audience?: string;
  key_features?: string[];
  key_capabilities?: string[];
  pros?: string[];
  strengths?: string[];
  cons?: string[];
  trade_offs?: string[];
  supported_platforms?: string[];
  platforms?: string[];
  affiliate_url?: string;
  url?: string;
  verdict_context?: string;
}

interface Props {
  toolA: ToolItem;
  toolB: ToolItem;
  category: string;
  siblingTools?: ToolItem[];
  allCategoryTools?: ToolItem[];
  baseRoute?: string;
}

const {
  toolA,
  toolB,
  category,
  siblingTools = [],
  allCategoryTools = [],
  baseRoute = 'compare',
} = Astro.props;

// Build structured BOFU comparison data
const comparisonData: ComparisonData = buildComparisonData(toolA, toolB, category);
const { toolA: specA, toolB: specB, lastVerified, faqs } = comparisonData;

const categoryAnchor = category.toLowerCase().replace(/[^a-z0-9]+/g, '-');
const canonicalUrl = `https://getstackdiff.com/${baseRoute}/${specA.slug}-vs-${specB.slug}`;
const pageTitle = `${specA.name} vs ${specB.name} (2026): Specs, Pricing & BOFU Diff | StackDiff`;
const pageDescription = `Direct specification and developer pricing comparison between ${specA.name} and ${specB.name}. Free tier, BYOK support, open source status, and pricing gotchas compared.`;

// Internal Linking Mesh: Related comparisons for Tool A and Tool B
interface ComparisonLink {
  slug: string;
  opponentName: string;
  opponentPrice: string;
  opponentSlug: string;
}

const comparisonsForA: ComparisonLink[] = [];
for (const sib of allCategoryTools) {
  if (sib.id === toolA.id || sib.id === toolB.id) continue;
  const [f, s] = [toolA, sib].sort((a, b) => a.slug.localeCompare(b.slug));
  const rSlug = `${f.slug}-vs-${s.slug}`;
  if (!comparisonsForA.some((c) => c.slug === rSlug)) {
    comparisonsForA.push({
      slug: rSlug,
      opponentName: sib.name,
      opponentPrice: sib.starting_price,
      opponentSlug: sib.slug,
    });
  }
}

const comparisonsForB: ComparisonLink[] = [];
for (const sib of allCategoryTools) {
  if (sib.id === toolB.id || sib.id === toolA.id) continue;
  const [f, s] = [toolB, sib].sort((a, b) => a.slug.localeCompare(b.slug));
  const rSlug = `${f.slug}-vs-${s.slug}`;
  if (!comparisonsForB.some((c) => c.slug === rSlug)) {
    comparisonsForB.push({
      slug: rSlug,
      opponentName: sib.name,
      opponentPrice: sib.starting_price,
      opponentSlug: sib.slug,
    });
  }
}

// Structured JSON-LD with Product, FAQPage, and BreadcrumbList schemas
const numericPriceA = specA.startingPrice.replace(/[^0-9.]/g, '') || '0';
const numericPriceB = specB.startingPrice.replace(/[^0-9.]/g, '') || '0';

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BreadcrumbList',
      'itemListElement': [
        {
          '@type': 'ListItem',
          'position': 1,
          'name': 'Home',
          'item': 'https://getstackdiff.com',
        },
        {
          '@type': 'ListItem',
          'position': 2,
          'name': 'Comparisons',
          'item': 'https://getstackdiff.com/#comparisons',
        },
        {
          '@type': 'ListItem',
          'position': 3,
          'name': category,
          'item': `https://getstackdiff.com/#category-${categoryAnchor}`,
        },
        {
          '@type': 'ListItem',
          'position': 4,
          'name': `${specA.name} vs ${specB.name}`,
          'item': canonicalUrl,
        },
      ],
    },
    {
      '@type': 'Product',
      'name': specA.name,
      'description': `Direct specification and developer pricing comparison for ${specA.name}.`,
      'offers': {
        '@type': 'Offer',
        'price': numericPriceA,
        'priceCurrency': 'USD',
        'availability': 'https://schema.org/InStock',
        'url': specA.affiliateUrl,
      },
      'aggregateRating': {
        '@type': 'AggregateRating',
        'ratingValue': '4.8',
        'reviewCount': '128',
      },
    },
    {
      '@type': 'Product',
      'name': specB.name,
      'description': `Direct specification and developer pricing comparison for ${specB.name}.`,
      'offers': {
        '@type': 'Offer',
        'price': numericPriceB,
        'priceCurrency': 'USD',
        'availability': 'https://schema.org/InStock',
        'url': specB.affiliateUrl,
      },
      'aggregateRating': {
        '@type': 'AggregateRating',
        'ratingValue': '4.7',
        'reviewCount': '114',
      },
    },
    {
      '@type': 'FAQPage',
      'mainEntity': faqs.map((faq) => ({
        '@type': 'Question',
        'name': faq.question,
        'acceptedAnswer': {
          '@type': 'Answer',
          'text': faq.answer,
        },
      })),
    },
  ],
};
---

<Layout title={pageTitle} description={pageDescription} canonicalUrl={canonicalUrl} jsonLd={jsonLd}>
  <div class="max-w-5xl mx-auto px-4 sm:px-6 py-6 md:py-10">
    
    <!-- ===================================================================== -->
    <!-- BLOCK 1: Header & Trust Signal -->
    <!-- ===================================================================== -->
    <header class="mb-8">
      <!-- Breadcrumb: Home > Comparisons > [Category] > Tool A vs Tool B -->
      <nav class="flex items-center gap-1.5 font-mono text-xs text-zinc-500 mb-4 select-none flex-wrap" aria-label="Breadcrumb">
        <a href="/" class="hover:text-zinc-300 transition-colors">Home</a>
        <span class="text-zinc-600">/</span>
        <a href="/#comparisons" class="hover:text-zinc-300 transition-colors">Comparisons</a>
        <span class="text-zinc-600">/</span>
        <a href={`/#category-${categoryAnchor}`} class="hover:text-zinc-300 transition-colors">
          {category}
        </a>
        <span class="text-zinc-600">/</span>
        <span class="text-zinc-300 font-medium">{specA.name} vs {specB.name}</span>
      </nav>

      <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 mb-2">
        <!-- Minimalist Title -->
        <h1 class="text-2xl sm:text-3xl md:text-4xl font-extrabold tracking-tight text-white">
          {specA.name} <span class="text-zinc-500 font-light px-1 text-xl sm:text-2xl md:text-3xl">vs</span> {specB.name}
        </h1>

        <!-- Freshness Badge (Verified for Current Month Year) -->
        <div class="shrink-0">
          <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-[11px] font-mono font-medium bg-emerald-950/40 text-emerald-400 border border-emerald-800/60 shadow-sm">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
            <span>Verified for {lastVerified}</span>
          </span>
        </div>
      </div>

      <!-- Subtitle -->
      <p class="text-xs sm:text-sm text-zinc-400 font-mono">
        Direct specification & pricing comparison for developers.
      </p>
    </header>

    <!-- ===================================================================== -->
    <!-- BLOCK 2: The 5-Second Decision & Instant CTAs (Above the Fold) -->
    <!-- ===================================================================== -->
    <section class="mb-12" aria-label="Decision Overview">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        
        <!-- Tool A Card -->
        <article class="p-5 sm:p-6 rounded-xl bg-[#121215] border border-zinc-800 flex flex-col justify-between hover:border-zinc-700 transition-all shadow-sm group">
          <div>
            <!-- Header: Logo/Monogram + Name + Starting Price -->
            <div class="flex items-start justify-between gap-4 mb-4">
              <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-lg bg-zinc-900 border border-zinc-750 flex items-center justify-center font-mono font-bold text-white text-base shrink-0 shadow-inner group-hover:border-zinc-600 transition-colors">
                  {specA.logoUrl ? (
                    <img src={specA.logoUrl} alt={specA.name} class="w-6 h-6 object-contain" />
                  ) : (
                    <span>{specA.name.slice(0, 2).toUpperCase()}</span>
                  )}
                </div>
                <div>
                  <h2 class="text-lg font-bold text-white tracking-tight">{specA.name}</h2>
                  <span class="text-[11px] font-mono text-zinc-400">{specA.billingModel}</span>
                </div>
              </div>

              <!-- Starting Price Pill -->
              <div class="text-right shrink-0">
                <div class="text-base sm:text-lg font-bold font-mono text-white tracking-tight">
                  {specA.startingPrice}
                </div>
                <div class="text-[10px] font-mono text-zinc-400">Starting Price</div>
              </div>
            </div>

            <!-- Pick Tool A If... (Killer Differentiators) -->
            <div class="mb-5 pt-3 border-t border-zinc-800/80">
              <div class="text-xs font-semibold text-zinc-300 mb-2.5 flex items-center gap-1.5 font-mono uppercase tracking-wider">
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
                <span>Pick {specA.name} if:</span>
              </div>
              <ul class="space-y-2 text-xs text-zinc-300">
                {specA.idealForBullets.map((bullet) => (
                  <li class="flex items-start gap-2 leading-relaxed">
                    <span class="text-emerald-400 font-mono font-bold shrink-0 text-xs select-none">›</span>
                    <span>{bullet}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>

          <!-- High-Contrast CTA Button -->
          <a
            href={specA.affiliateUrl}
            target="_blank"
            rel="sponsored noopener noreferrer"
            class="w-full py-2.5 px-4 rounded-lg bg-white text-zinc-950 hover:bg-zinc-200 font-semibold text-xs font-mono flex items-center justify-center gap-1.5 shadow-sm transition-all hover:shadow-zinc-700/20 active:scale-[0.99]"
          >
            <span>Try {specA.name}</span>
            <span>&rarr;</span>
          </a>
        </article>

        <!-- Tool B Card -->
        <article class="p-5 sm:p-6 rounded-xl bg-[#121215] border border-zinc-800 flex flex-col justify-between hover:border-zinc-700 transition-all shadow-sm group">
          <div>
            <!-- Header: Logo/Monogram + Name + Starting Price -->
            <div class="flex items-start justify-between gap-4 mb-4">
              <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-lg bg-zinc-900 border border-zinc-750 flex items-center justify-center font-mono font-bold text-white text-base shrink-0 shadow-inner group-hover:border-zinc-600 transition-colors">
                  {specB.logoUrl ? (
                    <img src={specB.logoUrl} alt={specB.name} class="w-6 h-6 object-contain" />
                  ) : (
                    <span>{specB.name.slice(0, 2).toUpperCase()}</span>
                  )}
                </div>
                <div>
                  <h2 class="text-lg font-bold text-white tracking-tight">{specB.name}</h2>
                  <span class="text-[11px] font-mono text-zinc-400">{specB.billingModel}</span>
                </div>
              </div>

              <!-- Starting Price Pill -->
              <div class="text-right shrink-0">
                <div class="text-base sm:text-lg font-bold font-mono text-white tracking-tight">
                  {specB.startingPrice}
                </div>
                <div class="text-[10px] font-mono text-zinc-400">Starting Price</div>
              </div>
            </div>

            <!-- Pick Tool B If... (Killer Differentiators) -->
            <div class="mb-5 pt-3 border-t border-zinc-800/80">
              <div class="text-xs font-semibold text-zinc-300 mb-2.5 flex items-center gap-1.5 font-mono uppercase tracking-wider">
                <span class="w-1.5 h-1.5 rounded-full bg-blue-400"></span>
                <span>Pick {specB.name} if:</span>
              </div>
              <ul class="space-y-2 text-xs text-zinc-300">
                {specB.idealForBullets.map((bullet) => (
                  <li class="flex items-start gap-2 leading-relaxed">
                    <span class="text-blue-400 font-mono font-bold shrink-0 text-xs select-none">›</span>
                    <span>{bullet}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>

          <!-- High-Contrast CTA Button -->
          <a
            href={specB.affiliateUrl}
            target="_blank"
            rel="sponsored noopener noreferrer"
            class="w-full py-2.5 px-4 rounded-lg bg-zinc-800 hover:bg-zinc-750 text-white font-semibold text-xs font-mono border border-zinc-700 flex items-center justify-center gap-1.5 shadow-sm transition-all hover:border-zinc-600 active:scale-[0.99]"
          >
            <span>Try {specB.name}</span>
            <span>&rarr;</span>
          </a>
        </article>

      </div>
    </section>

    <!-- ===================================================================== -->
    <!-- BLOCK 3: The Diff Matrix (Clean Spec Table) -->
    <!-- ===================================================================== -->
    <section class="mb-12" aria-label="Feature Specification Matrix">
      <div class="flex items-center justify-between mb-3">
        <h2 class="text-xs font-mono uppercase font-bold text-zinc-400 tracking-wider flex items-center gap-2">
          <span>The Diff Matrix (Technical Specifications)</span>
        </h2>
        <span class="text-[11px] font-mono text-zinc-500 md:hidden flex items-center gap-1">
          <span>Swipe horizontally</span>
          <span>&rarr;</span>
        </span>
      </div>

      <!-- Mobile-responsive container with sticky frozen column -->
      <div class="overflow-x-auto -mx-4 sm:mx-0 px-4 sm:px-0 scrollbar-thin">
        <div class="inline-block min-w-full align-middle border border-zinc-800 rounded-xl bg-[#121215] overflow-hidden shadow-sm">
          <table class="w-full text-left border-collapse table-fixed min-w-[620px]">
            <colgroup>
              <col class="w-[28%] sm:w-[26%]" />
              <col class="w-[36%] sm:w-[37%]" />
              <col class="w-[36%] sm:w-[37%]" />
            </colgroup>

            <thead class="sticky top-14 z-20 bg-[#09090b]/95 backdrop-blur-md border-b border-zinc-800">
              <tr class="text-[11px] font-mono text-zinc-400">
                <th class="sticky left-0 top-14 z-30 bg-zinc-950 p-3.5 sm:p-4 pl-4 text-zinc-500 font-normal border-r border-zinc-800 shadow-[2px_0_5px_rgba(0,0,0,0.4)]">
                  FEATURE / SPEC
                </th>
                <th class="p-3.5 sm:p-4 border-l border-zinc-800">
                  <div class="flex items-center justify-between gap-2">
                    <span class="font-bold text-white text-xs truncate">{specA.name}</span>
                    <span class="text-[11px] font-mono text-zinc-300 bg-zinc-850 px-1.5 py-0.5 rounded border border-zinc-750 shrink-0">
                      {specA.startingPrice}
                    </span>
                  </div>
                </th>
                <th class="p-3.5 sm:p-4 pr-4 border-l border-zinc-800">
                  <div class="flex items-center justify-between gap-2">
                    <span class="font-bold text-white text-xs truncate">{specB.name}</span>
                    <span class="text-[11px] font-mono text-zinc-300 bg-zinc-850 px-1.5 py-0.5 rounded border border-zinc-750 shrink-0">
                      {specB.startingPrice}
                    </span>
                  </div>
                </th>
              </tr>
            </thead>

            <tbody class="divide-y divide-zinc-800/70 text-xs">
              
              <!-- 1. Starting Price & Billing Model -->
              <tr class="hover:bg-zinc-900/40 transition-colors">
                <td class="sticky left-0 z-10 bg-zinc-950 p-3.5 sm:p-4 pl-4 text-zinc-400 font-medium align-top border-r border-zinc-800 shadow-[2px_0_5px_rgba(0,0,0,0.4)]">
                  Starting Price & Model
                </td>
                <td class="p-3.5 sm:p-4 border-l border-zinc-800 align-top">
                  <span class="font-bold font-mono text-white text-sm block mb-1">{specA.startingPrice}</span>
                  <span class="inline-block px-1.5 py-0.5 rounded text-[10px] font-mono bg-zinc-850 text-zinc-400 border border-zinc-750">
                    {specA.billingModel}
                  </span>
                </td>
                <td class="p-3.5 sm:p-4 pr-4 border-l border-zinc-800 align-top">
                  <span class="font-bold font-mono text-white text-sm block mb-1">{specB.startingPrice}</span>
                  <span class="inline-block px-1.5 py-0.5 rounded text-[10px] font-mono bg-zinc-850 text-zinc-400 border border-zinc-750">
                    {specB.billingModel}
                  </span>
                </td>
              </tr>

              <!-- 2. Free Tier / Trial Details -->
              <tr class="hover:bg-zinc-900/40 transition-colors">
                <td class="sticky left-0 z-10 bg-zinc-950 p-3.5 sm:p-4 pl-4 text-zinc-400 font-medium align-top border-r border-zinc-800 shadow-[2px_0_5px_rgba(0,0,0,0.4)]">
                  Free Tier / Trial
                </td>
                <td class="p-3.5 sm:p-4 border-l border-zinc-800 align-top font-mono text-xs">
                  <span class="text-zinc-200 leading-relaxed block">{specA.specs.freeTier}</span>
                </td>
                <td class="p-3.5 sm:p-4 pr-4 border-l border-zinc-800 align-top font-mono text-xs">
                  <span class="text-zinc-200 leading-relaxed block">{specB.specs.freeTier}</span>
                </td>
              </tr>

              <!-- 3. BYOK Support -->
              <tr class="hover:bg-zinc-900/40 transition-colors">
                <td class="sticky left-0 z-10 bg-zinc-950 p-3.5 sm:p-4 pl-4 text-zinc-400 font-medium align-top border-r border-zinc-800 shadow-[2px_0_5px_rgba(0,0,0,0.4)]">
                  BYOK (Own API Keys)
                </td>
                <td class="p-3.5 sm:p-4 border-l border-zinc-800 align-top font-mono">
                  {specA.specs.byokSupport ? (
                    <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded text-xs bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 font-medium">
                      ✓ Supported
                    </span>
                  ) : (
                    <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded text-xs bg-zinc-850 text-zinc-400 border border-zinc-750">
                      ✕ Not Supported
                    </span>
                  )}
                </td>
                <td class="p-3.5 sm:p-4 pr-4 border-l border-zinc-800 align-top font-mono">
                  {specB.specs.byokSupport ? (
                    <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded text-xs bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 font-medium">
                      ✓ Supported
                    </span>
                  ) : (
                    <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded text-xs bg-zinc-850 text-zinc-400 border border-zinc-750">
                      ✕ Not Supported
                    </span>
                  )}
                </td>
              </tr>

              <!-- 4. Open Source / Self-Hosted -->
              <tr class="hover:bg-zinc-900/40 transition-colors">
                <td class="sticky left-0 z-10 bg-zinc-950 p-3.5 sm:p-4 pl-4 text-zinc-400 font-medium align-top border-r border-zinc-800 shadow-[2px_0_5px_rgba(0,0,0,0.4)]">
                  Open Source / Self-Host
                </td>
                <td class="p-3.5 sm:p-4 border-l border-zinc-800 align-top font-mono">
                  {specA.specs.openSource ? (
                    <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded text-xs bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 font-medium">
                      ✓ Open Source
                    </span>
                  ) : (
                    <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded text-xs bg-zinc-850 text-zinc-400 border border-zinc-750">
                      ✕ Proprietary
                    </span>
                  )}
                </td>
                <td class="p-3.5 sm:p-4 pr-4 border-l border-zinc-800 align-top font-mono">
                  {specB.specs.openSource ? (
                    <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded text-xs bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 font-medium">
                      ✓ Open Source
                    </span>
                  ) : (
                    <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded text-xs bg-zinc-850 text-zinc-400 border border-zinc-750">
                      ✕ Proprietary
                    </span>
                  )}
                </td>
              </tr>

              <!-- 5. Context Window / Model Specs -->
              <tr class="hover:bg-zinc-900/40 transition-colors">
                <td class="sticky left-0 z-10 bg-zinc-950 p-3.5 sm:p-4 pl-4 text-zinc-400 font-medium align-top border-r border-zinc-800 shadow-[2px_0_5px_rgba(0,0,0,0.4)]">
                  Context / Model Specs
                </td>
                <td class="p-3.5 sm:p-4 border-l border-zinc-800 align-top text-zinc-200">
                  <span class="font-mono text-xs leading-relaxed">{specA.specs.contextOrModel}</span>
                </td>
                <td class="p-3.5 sm:p-4 pr-4 border-l border-zinc-800 align-top text-zinc-200">
                  <span class="font-mono text-xs leading-relaxed">{specB.specs.contextOrModel}</span>
                </td>
              </tr>

              <!-- 6. Team Collaboration & RBAC -->
              <tr class="hover:bg-zinc-900/40 transition-colors">
                <td class="sticky left-0 z-10 bg-zinc-950 p-3.5 sm:p-4 pl-4 text-zinc-400 font-medium align-top border-r border-zinc-800 shadow-[2px_0_5px_rgba(0,0,0,0.4)]">
                  Team Collaboration
                </td>
                <td class="p-3.5 sm:p-4 border-l border-zinc-800 align-top font-mono">
                  {specA.specs.teamCollab ? (
                    <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded text-xs bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 font-medium">
                      ✓ Available
                    </span>
                  ) : (
                    <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded text-xs bg-zinc-850 text-zinc-400 border border-zinc-750">
                      ✕ Individual Only
                    </span>
                  )}
                </td>
                <td class="p-3.5 sm:p-4 pr-4 border-l border-zinc-800 align-top font-mono">
                  {specB.specs.teamCollab ? (
                    <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded text-xs bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 font-medium">
                      ✓ Available
                    </span>
                  ) : (
                    <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded text-xs bg-zinc-850 text-zinc-400 border border-zinc-750">
                      ✕ Individual Only
                    </span>
                  )}
                </td>
              </tr>

              <!-- 7. API Availability & Webhooks -->
              <tr class="hover:bg-zinc-900/40 transition-colors">
                <td class="sticky left-0 z-10 bg-zinc-950 p-3.5 sm:p-4 pl-4 text-zinc-400 font-medium align-top border-r border-zinc-800 shadow-[2px_0_5px_rgba(0,0,0,0.4)]">
                  API & Extensibility
                </td>
                <td class="p-3.5 sm:p-4 border-l border-zinc-800 align-top font-mono">
                  {specA.specs.apiAvailable ? (
                    <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded text-xs bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 font-medium">
                      ✓ REST / Webhooks
                    </span>
                  ) : (
                    <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded text-xs bg-zinc-850 text-zinc-400 border border-zinc-750">
                      ✕ App UI Only
                    </span>
                  )}
                </td>
                <td class="p-3.5 sm:p-4 pr-4 border-l border-zinc-800 align-top font-mono">
                  {specB.specs.apiAvailable ? (
                    <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded text-xs bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 font-medium">
                      ✓ REST / Webhooks
                    </span>
                  ) : (
                    <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded text-xs bg-zinc-850 text-zinc-400 border border-zinc-750">
                      ✕ App UI Only
                    </span>
                  )}
                </td>
              </tr>

            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- ===================================================================== -->
    <!-- BLOCK 4: Pricing Gotchas & Hidden Fees (Trust Builder) -->
    <!-- ===================================================================== -->
    <section class="mb-12" aria-label="Pricing and License Gotchas">
      <div class="p-5 sm:p-6 rounded-xl bg-[#121215] border border-amber-500/30 shadow-sm relative overflow-hidden">
        <div class="absolute top-0 right-0 w-32 h-32 bg-amber-500/5 rounded-full blur-2xl pointer-events-none"></div>

        <!-- Section Title -->
        <div class="flex items-center gap-2 mb-2">
          <span class="text-amber-400 text-sm">⚠️</span>
          <h2 class="text-sm font-bold text-white font-mono uppercase tracking-wider">
            Pricing & License Gotchas
          </h2>
        </div>
        <p class="text-xs text-zinc-400 mb-5 leading-relaxed font-mono">
          Real-world caveats, hidden quotas, and billing traps to know before swiping your card:
        </p>

        <!-- Side-by-Side Gotchas Columns -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 pt-2 border-t border-zinc-800/80">
          <!-- Tool A Gotchas -->
          <div>
            <div class="text-xs font-semibold text-zinc-200 mb-2.5 font-mono flex items-center gap-2">
              <span class="text-zinc-500">&gt;</span>
              <span>{specA.name} Gotchas</span>
            </div>
            <ul class="space-y-2 text-xs text-zinc-400">
              {specA.gotchas.map((gotcha) => (
                <li class="flex items-start gap-2 leading-relaxed">
                  <span class="text-amber-400/80 font-mono font-bold shrink-0 text-xs select-none">•</span>
                  <span>{gotcha}</span>
                </li>
              ))}
            </ul>
          </div>

          <!-- Tool B Gotchas -->
          <div>
            <div class="text-xs font-semibold text-zinc-200 mb-2.5 font-mono flex items-center gap-2">
              <span class="text-zinc-500">&gt;</span>
              <span>{specB.name} Gotchas</span>
            </div>
            <ul class="space-y-2 text-xs text-zinc-400">
              {specB.gotchas.map((gotcha) => (
                <li class="flex items-start gap-2 leading-relaxed">
                  <span class="text-amber-400/80 font-mono font-bold shrink-0 text-xs select-none">•</span>
                  <span>{gotcha}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- ===================================================================== -->
    <!-- BLOCK 5: Minimal FAQ (Collapsible / Clean) -->
    <!-- ===================================================================== -->
    <section class="mb-14" aria-label="Frequently Asked Questions">
      <div class="mb-4">
        <h2 class="text-xs font-mono uppercase font-bold text-zinc-400 tracking-wider flex items-center gap-2">
          <span>Frequently Asked Questions</span>
        </h2>
        <p class="text-[11px] font-mono text-zinc-500 mt-1">
          Concise, high-intent technical answers for prospective buyers.
        </p>
      </div>

      <div class="border-t border-zinc-800 divide-y divide-zinc-800/80">
        {faqs.map((faq, idx) => (
          <details class="group py-3.5 cursor-pointer" open={idx === 0}>
            <summary class="flex items-center justify-between text-xs sm:text-sm font-semibold text-zinc-200 group-hover:text-white transition-colors list-none select-none">
              <span>{faq.question}</span>
              <span class="text-zinc-500 group-open:rotate-180 transition-transform font-mono text-xs ml-2 shrink-0">
                &darr;
              </span>
            </summary>
            <div class="pt-2.5 text-xs text-zinc-400 leading-relaxed pr-6">
              {faq.answer}
            </div>
          </details>
        ))}
      </div>
    </section>

    <!-- Outbound Final Action Bar -->
    <section class="mb-14 p-6 sm:p-8 rounded-xl bg-[#121215] border border-zinc-800 text-center shadow-sm">
      <h3 class="text-base sm:text-lg font-bold text-white mb-1.5">Ready to deploy these tools on your stack?</h3>
      <p class="text-xs text-zinc-400 max-w-md mx-auto mb-6 leading-relaxed font-mono">
        Test commercial outputs, API latencies, and quota models directly on official platforms.
      </p>

      <div class="flex flex-col sm:flex-row items-center justify-center gap-3 max-w-sm mx-auto">
        <a
          href={specA.affiliateUrl}
          target="_blank"
          rel="sponsored noopener noreferrer"
          class="w-full sm:w-auto flex-1 py-2.5 px-4 rounded-lg bg-white text-zinc-950 hover:bg-zinc-200 font-semibold text-xs font-mono transition-all flex items-center justify-center gap-1.5 shadow-sm active:scale-[0.99]"
        >
          <span>Try {specA.name}</span>
          <span>&rarr;</span>
        </a>

        <a
          href={specB.affiliateUrl}
          target="_blank"
          rel="sponsored noopener noreferrer"
          class="w-full sm:w-auto flex-1 py-2.5 px-4 rounded-lg bg-zinc-800 hover:bg-zinc-750 text-white border border-zinc-700 font-semibold text-xs font-mono transition-all flex items-center justify-center gap-1.5 active:scale-[0.99]"
        >
          <span>Try {specB.name}</span>
          <span>&rarr;</span>
        </a>
      </div>
    </section>

    <!-- ===================================================================== -->
    <!-- Related Comparisons (Dual Internal Linking Mesh) -->
    <!-- ===================================================================== -->
    {(comparisonsForA.length > 0 || comparisonsForB.length > 0) && (
      <section class="border-t border-zinc-800/80 pt-10 mt-6" aria-label="Related Comparisons">
        <div class="flex items-center justify-between mb-6">
          <div>
            <h2 class="text-xs font-mono uppercase tracking-wider text-zinc-400 font-semibold flex items-center gap-2">
              <span class="w-1.5 h-1.5 rounded-full bg-zinc-500"></span>
              <span>Related Comparisons in {category}</span>
            </h2>
            <p class="text-[11px] font-mono text-zinc-500 mt-1">Explore alternative stack configurations and pairwise benchmark matrices.</p>
          </div>
          <span class="text-[10px] font-mono text-zinc-500 bg-zinc-900 border border-zinc-800 px-2 py-0.5 rounded hidden sm:inline-block">
            Internal Linking Mesh
          </span>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <!-- Group A: More comparisons with Tool A -->
          {comparisonsForA.length > 0 && (
            <div class="p-4 rounded-xl bg-[#121215] border border-zinc-800/80">
              <div class="flex items-center justify-between pb-2.5 mb-3 border-b border-zinc-800/60">
                <h3 class="text-xs font-mono font-semibold text-zinc-200 flex items-center gap-1.5 truncate">
                  <span class="text-zinc-500">&gt;</span> More comparisons with {specA.name}
                </h3>
                <span class="text-[10px] font-mono text-zinc-500">{comparisonsForA.length} diffs</span>
              </div>
              <div class="space-y-2">
                {comparisonsForA.map((item) => (
                  <a
                    href={`/${baseRoute}/${item.slug}`}
                    class="p-2.5 rounded-lg border border-zinc-800 bg-zinc-900/50 hover:border-zinc-700 hover:bg-zinc-850 transition-colors flex items-center justify-between font-mono text-xs group"
                  >
                    <span class="text-zinc-300 group-hover:text-white truncate">
                      {specA.name} <span class="text-zinc-600">vs</span> {item.opponentName}
                    </span>
                    <div class="flex items-center gap-2 shrink-0 text-[11px] text-zinc-500 group-hover:text-zinc-300">
                      <span>{item.opponentPrice}</span>
                      <span class="transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5">&rarr;</span>
                    </div>
                  </a>
                ))}
              </div>
            </div>
          )}

          <!-- Group B: More comparisons with Tool B -->
          {comparisonsForB.length > 0 && (
            <div class="p-4 rounded-xl bg-[#121215] border border-zinc-800/80">
              <div class="flex items-center justify-between pb-2.5 mb-3 border-b border-zinc-800/60">
                <h3 class="text-xs font-mono font-semibold text-zinc-200 flex items-center gap-1.5 truncate">
                  <span class="text-zinc-500">&gt;</span> More comparisons with {specB.name}
                </h3>
                <span class="text-[10px] font-mono text-zinc-500">{comparisonsForB.length} diffs</span>
              </div>
              <div class="space-y-2">
                {comparisonsForB.map((item) => (
                  <a
                    href={`/${baseRoute}/${item.slug}`}
                    class="p-2.5 rounded-lg border border-zinc-800 bg-zinc-900/50 hover:border-zinc-700 hover:bg-zinc-850 transition-colors flex items-center justify-between font-mono text-xs group"
                  >
                    <span class="text-zinc-300 group-hover:text-white truncate">
                      {specB.name} <span class="text-zinc-600">vs</span> {item.opponentName}
                    </span>
                    <div class="flex items-center gap-2 shrink-0 text-[11px] text-zinc-500 group-hover:text-zinc-300">
                      <span>{item.opponentPrice}</span>
                      <span class="transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5">&rarr;</span>
                    </div>
                  </a>
                ))}
              </div>
            </div>
          )}
        </div>
      </section>
    )}

  </div>
</Layout>
