---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  ogType?: string;
  ogImage?: string;
  canonicalUrl?: string;
  jsonLd?: Record<string, any>;
}

const {
  title,
  description,
  ogType = 'website',
  ogImage = '/og-default.png',
  canonicalUrl = Astro.url.href,
  jsonLd,
} = Astro.props;
---

<!doctype html>
<html lang="en" class="dark scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO Meta Tags -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:site_name" content="StackDiff" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalUrl} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Google Fonts: Inter & JetBrains Mono -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />

    {jsonLd && (
      <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    )}
  </head>
  <body class="min-h-screen flex flex-col bg-dark-950 text-dark-200">
    <!-- Ambient background gradient & grid -->
    <div class="fixed inset-0 bg-hero-gradient pointer-events-none -z-10"></div>
    <div class="fixed inset-0 bg-grid-pattern bg-dots opacity-40 pointer-events-none -z-10"></div>

    <!-- Global Navigation -->
    <header class="sticky top-0 z-50 border-b border-dark-800/80 bg-dark-950/80 backdrop-blur-md">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
        <!-- Logo -->
        <a href="/" class="flex items-center gap-2 group">
          <div class="w-8 h-8 rounded-lg bg-gradient-to-tr from-brand-indigo to-brand-cyan flex items-center justify-center font-mono font-bold text-white text-sm shadow-lg shadow-brand-indigo/20 group-hover:scale-105 transition-transform">
            <span>±</span>
          </div>
          <span class="font-bold text-lg text-white tracking-tight flex items-center gap-1.5">
            Stack<span class="text-brand-cyan">Diff</span>
            <span class="text-[10px] font-mono uppercase px-1.5 py-0.5 rounded bg-dark-800 text-brand-indigo border border-dark-700">pSEO</span>
          </span>
        </a>

        <!-- Navigation Links -->
        <nav class="hidden md:flex items-center gap-6 text-sm font-medium text-dark-400">
          <a href="/#categories" class="hover:text-white transition-colors">Categories</a>
          <a href="/#popular-comparisons" class="hover:text-white transition-colors">Comparisons</a>
          <span class="text-dark-700">|</span>
          <div class="flex items-center gap-1.5 text-xs text-dark-400 bg-dark-900 border border-dark-800 px-2.5 py-1 rounded-full font-mono">
            <span class="w-1.5 h-1.5 rounded-full bg-brand-emerald animate-pulse"></span>
            <span>20 Tools Indexed</span>
          </div>
        </nav>

        <!-- Right Action -->
        <div class="flex items-center gap-3">
          <a
            href="/#popular-comparisons"
            class="text-xs font-semibold px-3.5 py-2 rounded-lg bg-dark-850 hover:bg-dark-800 text-white border border-dark-700 hover:border-brand-indigo/50 transition-all shadow-sm"
          >
            Explore Diffs &rarr;
          </a>
        </div>
      </div>
    </header>

    <!-- Main Content Slot -->
    <main class="flex-grow">
      <slot />
    </main>

    <!-- Global Footer -->
    <footer class="border-t border-dark-800/80 bg-dark-900/60 py-12 mt-20">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 md:grid-cols-4 gap-8 mb-8">
          <div class="md:col-span-2">
            <div class="flex items-center gap-2 mb-3">
              <div class="w-6 h-6 rounded bg-brand-indigo flex items-center justify-center font-mono font-bold text-white text-xs">
                ±
              </div>
              <span class="font-bold text-white text-base">StackDiff</span>
            </div>
            <p class="text-sm text-dark-400 max-w-sm leading-relaxed">
              Objective, data-driven side-by-side AI tool comparisons. Designed for engineering leads, creators, and product teams building modern AI stacks.
            </p>
          </div>

          <div>
            <h4 class="text-xs font-semibold uppercase tracking-wider text-dark-300 mb-3 font-mono">Categories</h4>
            <ul class="space-y-2 text-sm text-dark-400">
              <li><a href="/#categories" class="hover:text-white transition-colors">Voice AI</a></li>
              <li><a href="/#categories" class="hover:text-white transition-colors">Video AI</a></li>
              <li><a href="/#categories" class="hover:text-white transition-colors">LLMs & Reasoning</a></li>
              <li><a href="/#categories" class="hover:text-white transition-colors">Coding AI</a></li>
              <li><a href="/#categories" class="hover:text-white transition-colors">Workflow & Automation</a></li>
            </ul>
          </div>

          <div>
            <h4 class="text-xs font-semibold uppercase tracking-wider text-dark-300 mb-3 font-mono">About Engine</h4>
            <p class="text-xs text-dark-500 leading-relaxed">
              Programmatic SEO engine rendering static comparison matrices from structured JSON specifications. Updated continuously for 2026 AI tool releases.
            </p>
          </div>
        </div>

        <div class="pt-8 border-t border-dark-800 flex flex-col sm:flex-row items-center justify-between text-xs text-dark-500 gap-4">
          <p>&copy; 2026 StackDiff Engine. All specifications verified objectively.</p>
          <p class="font-mono">Built with Astro + Tailwind CSS</p>
        </div>
      </div>
    </footer>
  </body>
</html>
