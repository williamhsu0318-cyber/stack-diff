---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  ogType?: string;
  ogImage?: string;
  canonicalUrl?: string;
  jsonLd?: Record<string, any>;
}

const {
  title,
  description,
  ogType = 'website',
  ogImage = '/og-default.png',
  canonicalUrl = Astro.url.href,
  jsonLd,
} = Astro.props;
---

<!doctype html>
<html lang="en" class="dark scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO Meta Tags -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:site_name" content="StackDiff" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalUrl} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Google Fonts: Inter & JetBrains Mono -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />

    {jsonLd && (
      <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    )}
  </head>
  <body class="min-h-screen flex flex-col bg-[#09090b] text-zinc-300 font-sans antialiased selection:bg-zinc-800 selection:text-white">
    <!-- Minimalist Global Header -->
    <header class="sticky top-0 z-50 border-b border-zinc-800/80 bg-[#09090b]/90 backdrop-blur-md">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 h-14 flex items-center justify-between">
        <!-- Logo -->
        <a href="/" class="flex items-center gap-2 group">
          <div class="w-6 h-6 rounded bg-zinc-900 border border-zinc-750 flex items-center justify-center font-mono font-bold text-zinc-200 text-xs group-hover:border-zinc-500 transition-colors">
            ±
          </div>
          <span class="font-bold text-sm text-zinc-100 tracking-tight flex items-center gap-1.5">
            Stack<span class="text-white">Diff</span>
            <span class="text-[10px] font-mono uppercase px-1.5 py-0.5 rounded bg-zinc-900 text-zinc-400 border border-zinc-800">ENGINE</span>
          </span>
        </a>

        <!-- Navigation Links -->
        <nav class="hidden md:flex items-center gap-5 text-xs font-medium text-zinc-400">
          <a href="/#categories" class="hover:text-zinc-100 transition-colors">Categories</a>
          <a href="/#popular-comparisons" class="hover:text-zinc-100 transition-colors">Matrices</a>
          <span class="text-zinc-800">|</span>
          <div class="flex items-center gap-1.5 text-[11px] text-zinc-400 bg-zinc-900 border border-zinc-800 px-2 py-0.5 rounded font-mono">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
            <span>31 Tools Indexed</span>
          </div>
        </nav>

        <!-- Right Action -->
        <div class="flex items-center gap-2">
          <a
            href="/#popular-comparisons"
            class="text-xs font-mono px-3 py-1.5 rounded bg-zinc-900 hover:bg-zinc-850 text-zinc-200 border border-zinc-800 hover:border-zinc-700 transition-colors"
          >
            Browse Diffs &rarr;
          </a>
        </div>
      </div>
    </header>

    <!-- Main Content -->
    <main class="flex-grow">
      <slot />
    </main>

    <!-- Global Minimalist Footer with Regulatory Affiliate Disclosure -->
    <footer class="border-t border-zinc-800/80 bg-[#09090b] py-10 mt-16 text-xs text-zinc-500">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 space-y-6">
        <!-- Affiliate Disclosure -->
        <div class="p-3.5 rounded bg-zinc-900/60 border border-zinc-800/70 text-[11px] leading-relaxed text-zinc-400 font-mono">
          <span class="text-zinc-300 font-semibold uppercase tracking-wider block mb-1">Affiliate Disclosure &amp; Policy:</span>
          StackDiff is an independent software comparison directory. When you purchase through our links, we may earn an affiliate commission at no extra cost to you. We strictly evaluate tools on objective technical specifications.
        </div>

        <div class="flex flex-col sm:flex-row items-center justify-between gap-4 pt-2 border-t border-zinc-900">
          <div class="flex items-center gap-2">
            <span class="font-mono text-zinc-400 font-semibold">StackDiff</span>
            <span class="text-zinc-700">•</span>
            <span>Objective side-by-side AI tool specifications.</span>
          </div>
          <div class="flex items-center gap-4 font-mono text-[11px] text-zinc-500">
            <span>Updated for 2026</span>
            <span>•</span>
            <a href="/#categories" class="hover:text-zinc-300 transition-colors">All Taxonomies</a>
            <span>•</span>
            <a href="/sitemap-index.xml" class="hover:text-zinc-300 transition-colors">Sitemap</a>
          </div>
        </div>
      </div>
    </footer>
  </body>
</html>
