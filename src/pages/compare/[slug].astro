---
import Layout from '../../layouts/Layout.astro';
import toolsData from '../../../data/tools.json';

export interface ToolItem {
  id: string;
  name: string;
  slug: string;
  category: string;
  tagline: string;
  pricing_model: string;
  starting_price: string;
  free_tier: boolean;
  best_for: string;
  key_features: string[];
  pros: string[];
  cons: string[];
  supported_platforms: string[];
  affiliate_url: string;
}

export async function getStaticPaths() {
  const tools = toolsData as ToolItem[];

  // Group tools strictly by category
  const categoryMap = new Map<string, ToolItem[]>();
  for (const tool of tools) {
    if (!categoryMap.has(tool.category)) {
      categoryMap.set(tool.category, []);
    }
    categoryMap.get(tool.category)!.push(tool);
  }

  const paths = [];

  for (const [category, groupTools] of categoryMap.entries()) {
    if (groupTools.length < 2) continue;

    for (let i = 0; i < groupTools.length; i++) {
      for (let j = i + 1; j < groupTools.length; j++) {
        const item1 = groupTools[i];
        const item2 = groupTools[j];

        // Alphabetical ordering to prevent duplicate reciprocal pages
        const [toolA, toolB] = [item1, item2].sort((a, b) =>
          a.slug.localeCompare(b.slug)
        );

        const slug = `${toolA.slug}-vs-${toolB.slug}`;

        // Related tools in same category for internal linking mesh
        const relatedTools = groupTools.filter(
          (t) => t.id !== toolA.id && t.id !== toolB.id
        );

        paths.push({
          params: { slug },
          props: {
            toolA,
            toolB,
            category,
            relatedTools,
          },
        });
      }
    }
  }

  return paths;
}

interface Props {
  toolA: ToolItem;
  toolB: ToolItem;
  category: string;
  relatedTools: ToolItem[];
}

const { toolA, toolB, category, relatedTools = [] } = Astro.props;

// Data limitation logic: Cap items to prevent layout clutter and text overlap
const maxFeatures = 4;
const maxPros = 3;
const maxCons = 3;
const maxPlatforms = 4;

const toolAFeatures = toolA.key_features.slice(0, maxFeatures);
const toolBFeatures = toolB.key_features.slice(0, maxFeatures);

const toolAPros = toolA.pros.slice(0, maxPros);
const toolBPros = toolB.pros.slice(0, maxPros);

const toolACons = toolA.cons.slice(0, maxCons);
const toolBCons = toolB.cons.slice(0, maxCons);

const toolAPlatforms = toolA.supported_platforms.slice(0, maxPlatforms);
const toolAPlatformsExtra = toolA.supported_platforms.length - maxPlatforms;

const toolBPlatforms = toolB.supported_platforms.slice(0, maxPlatforms);
const toolBPlatformsExtra = toolB.supported_platforms.length - maxPlatforms;

// SEO Metadata
const pageTitle = `${toolA.name} vs ${toolB.name} (2026): In-Depth Comparison, Pricing & Verdict | StackDiff`;
const pageDescription = `Compare ${toolA.name} and ${toolB.name}. See full side-by-side feature matrix, pricing differences, pros & cons, and which ${category} tool is right for you.`;

// Schema.org JSON-LD
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": `${toolA.name} vs ${toolB.name} (2026 Comparison)`,
  "description": pageDescription,
  "datePublished": "2026-01-15T08:00:00+08:00",
  "dateModified": "2026-09-02T16:00:00+08:00",
  "author": {
    "@type": "Organization",
    "name": "StackDiff Engine"
  },
  "mainEntity": [
    {
      "@type": "SoftwareApplication",
      "name": toolA.name,
      "applicationCategory": toolA.category,
      "offers": {
        "@type": "Offer",
        "price": toolA.starting_price.replace(/[^0-9.]/g, '') || "0",
        "priceCurrency": "USD"
      }
    },
    {
      "@type": "SoftwareApplication",
      "name": toolB.name,
      "applicationCategory": toolB.category,
      "offers": {
        "@type": "Offer",
        "price": toolB.starting_price.replace(/[^0-9.]/g, '') || "0",
        "priceCurrency": "USD"
      }
    }
  ]
};
---

<Layout title={pageTitle} description={pageDescription} jsonLd={jsonLd}>
  <div class="max-w-5xl mx-auto px-4 sm:px-6 py-6 md:py-8">
    
    <!-- 1. Breadcrumbs -->
    <nav class="flex items-center gap-1.5 text-[11px] text-zinc-500 font-mono mb-6" aria-label="Breadcrumb">
      <a href="/" class="hover:text-zinc-300 transition-colors">Home</a>
      <span>/</span>
      <a href="/#categories" class="hover:text-zinc-300 transition-colors">{category}</a>
      <span>/</span>
      <span class="text-zinc-200">{toolA.name} vs {toolB.name}</span>
    </nav>

    <!-- 2. Hero & Quick Verdict Header -->
    <header class="mb-8">
      <!-- Tag / Category Header -->
      <div class="flex items-center gap-2 mb-3">
        <span class="text-[11px] font-mono px-2 py-0.5 rounded bg-zinc-900 text-zinc-400 border border-zinc-800">
          {category}
        </span>
        <span class="text-zinc-700">•</span>
        <span class="text-[11px] font-mono text-zinc-500">2026 Spec Matrix</span>
      </div>

      <!-- Duel Title -->
      <h1 class="text-2xl sm:text-3xl md:text-4xl font-bold tracking-tight text-white mb-6">
        {toolA.name} <span class="text-zinc-500 font-light px-1">vs</span> {toolB.name}
      </h1>

      <!-- The Bottom Line Verdict (Immediate, High Visibility) -->
      <div class="p-4 sm:p-5 rounded-lg bg-[#121215] border border-zinc-800 mb-6">
        <div class="flex items-center gap-2 mb-2 font-mono text-xs font-semibold uppercase tracking-wider text-zinc-300">
          <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
          <span>The Bottom Line Verdict</span>
        </div>
        <div class="grid sm:grid-cols-2 gap-4 text-xs sm:text-sm text-zinc-300 leading-relaxed divide-y sm:divide-y-0 sm:divide-x divide-zinc-800">
          <div class="pt-2 sm:pt-0 sm:pr-4">
            <span class="font-semibold text-white">Choose {toolA.name}:</span>
            <span class="text-zinc-400 ml-1 line-clamp-2">{toolA.best_for}.</span>
          </div>
          <div class="pt-3 sm:pt-0 sm:pl-4">
            <span class="font-semibold text-white">Choose {toolB.name}:</span>
            <span class="text-zinc-400 ml-1 line-clamp-2">{toolB.best_for}.</span>
          </div>
        </div>
      </div>

      <!-- Compact Duel Summary Cards -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
        <!-- Card Tool A -->
        <div class="p-4 rounded-lg bg-[#121215] border border-zinc-800 flex items-center justify-between gap-4">
          <div class="min-w-0">
            <div class="flex items-center gap-2 mb-1">
              <span class="font-bold text-white text-base truncate">{toolA.name}</span>
              <span class="text-[10px] font-mono px-1.5 py-0.2 rounded bg-zinc-850 text-zinc-400 border border-zinc-750">
                {toolA.pricing_model}
              </span>
            </div>
            <div class="flex items-baseline gap-2">
              <span class="text-lg font-mono font-bold text-white">{toolA.starting_price}</span>
              <span class="text-[11px] font-mono text-zinc-500">
                {toolA.free_tier ? 'Free tier available' : 'Paid only'}
              </span>
            </div>
          </div>
          <a
            href={toolA.affiliate_url}
            target="_blank"
            rel="noopener noreferrer"
            class="shrink-0 px-3.5 py-1.5 rounded bg-white text-zinc-950 hover:bg-zinc-200 text-xs font-semibold font-mono flex items-center gap-1 transition-colors"
          >
            <span>Visit</span>
            <span>↗</span>
          </a>
        </div>

        <!-- Card Tool B -->
        <div class="p-4 rounded-lg bg-[#121215] border border-zinc-800 flex items-center justify-between gap-4">
          <div class="min-w-0">
            <div class="flex items-center gap-2 mb-1">
              <span class="font-bold text-white text-base truncate">{toolB.name}</span>
              <span class="text-[10px] font-mono px-1.5 py-0.2 rounded bg-zinc-850 text-zinc-400 border border-zinc-750">
                {toolB.pricing_model}
              </span>
            </div>
            <div class="flex items-baseline gap-2">
              <span class="text-lg font-mono font-bold text-white">{toolB.starting_price}</span>
              <span class="text-[11px] font-mono text-zinc-500">
                {toolB.free_tier ? 'Free tier available' : 'Paid only'}
              </span>
            </div>
          </div>
          <a
            href={toolB.affiliate_url}
            target="_blank"
            rel="noopener noreferrer"
            class="shrink-0 px-3.5 py-1.5 rounded bg-zinc-800 hover:bg-zinc-700 text-white text-xs font-semibold font-mono border border-zinc-700 flex items-center gap-1 transition-colors"
          >
            <span>Visit</span>
            <span>↗</span>
          </a>
        </div>
      </div>
    </header>

    <!-- 3. Core Spec Comparison Matrix (Strict Table Layout, No Overlap) -->
    <section class="mb-12">
      <div class="flex items-center justify-between mb-3">
        <h2 class="text-base font-bold text-white tracking-tight flex items-center gap-2 font-mono uppercase text-xs">
          <span>Side-by-Side Technical Specs</span>
        </h2>
        <span class="text-[11px] font-mono text-zinc-500">Fixed column layout</span>
      </div>

      <div class="overflow-x-auto border border-zinc-800 rounded-lg bg-[#121215] shadow-sm">
        <table class="w-full text-left border-collapse table-fixed min-w-[640px]">
          <colgroup>
            <col class="w-[24%]" />
            <col class="w-[38%]" />
            <col class="w-[38%]" />
          </colgroup>

          <!-- Sticky Table Header -->
          <thead class="sticky top-14 z-20 bg-[#121215]/95 backdrop-blur border-b border-zinc-800">
            <tr class="text-[11px] font-mono text-zinc-400">
              <th class="p-3.5 pl-4 text-zinc-500 font-normal">SPECIFICATION</th>
              <th class="p-3.5 border-l border-zinc-800/80">
                <div class="flex items-center justify-between gap-2">
                  <span class="font-bold text-white text-xs truncate">{toolA.name}</span>
                  <span class="text-[11px] font-mono text-zinc-300 bg-zinc-800 px-1.5 py-0.5 rounded shrink-0">
                    {toolA.starting_price}
                  </span>
                </div>
              </th>
              <th class="p-3.5 pr-4 border-l border-zinc-800/80">
                <div class="flex items-center justify-between gap-2">
                  <span class="font-bold text-white text-xs truncate">{toolB.name}</span>
                  <span class="text-[11px] font-mono text-zinc-300 bg-zinc-800 px-1.5 py-0.5 rounded shrink-0">
                    {toolB.starting_price}
                  </span>
                </div>
              </th>
            </tr>
          </thead>

          <tbody class="divide-y divide-zinc-800/70 text-xs">
            <!-- Starting Price -->
            <tr class="hover:bg-zinc-900/40 transition-colors">
              <td class="p-3.5 pl-4 text-zinc-400 font-medium align-top">Starting Price</td>
              <td class="p-3.5 border-l border-zinc-800/80 align-top">
                <span class="text-sm font-bold font-mono text-white block">{toolA.starting_price}</span>
              </td>
              <td class="p-3.5 pr-4 border-l border-zinc-800/80 align-top">
                <span class="text-sm font-bold font-mono text-white block">{toolB.starting_price}</span>
              </td>
            </tr>

            <!-- Pricing Model -->
            <tr class="hover:bg-zinc-900/40 transition-colors">
              <td class="p-3.5 pl-4 text-zinc-400 font-medium align-top">Pricing Model</td>
              <td class="p-3.5 border-l border-zinc-800/80 align-top">
                <span class="inline-block px-2 py-0.5 rounded text-[11px] font-mono bg-zinc-800 text-zinc-300 border border-zinc-700">
                  {toolA.pricing_model}
                </span>
              </td>
              <td class="p-3.5 pr-4 border-l border-zinc-800/80 align-top">
                <span class="inline-block px-2 py-0.5 rounded text-[11px] font-mono bg-zinc-800 text-zinc-300 border border-zinc-700">
                  {toolB.pricing_model}
                </span>
              </td>
            </tr>

            <!-- Free Tier -->
            <tr class="hover:bg-zinc-900/40 transition-colors">
              <td class="p-3.5 pl-4 text-zinc-400 font-medium align-top">Free Tier / Trial</td>
              <td class="p-3.5 border-l border-zinc-800/80 align-top font-mono text-[11px]">
                {toolA.free_tier ? (
                  <span class="text-emerald-400 flex items-center gap-1 font-medium">
                    <span>✓</span> Permanent Free Quota
                  </span>
                ) : (
                  <span class="text-zinc-500 flex items-center gap-1">
                    <span>✕</span> Paid Only (No Free Tier)
                  </span>
                )}
              </td>
              <td class="p-3.5 pr-4 border-l border-zinc-800/80 align-top font-mono text-[11px]">
                {toolB.free_tier ? (
                  <span class="text-emerald-400 flex items-center gap-1 font-medium">
                    <span>✓</span> Permanent Free Quota
                  </span>
                ) : (
                  <span class="text-zinc-500 flex items-center gap-1">
                    <span>✕</span> Paid Only (No Free Tier)
                  </span>
                )}
              </td>
            </tr>

            <!-- Best For -->
            <tr class="hover:bg-zinc-900/40 transition-colors">
              <td class="p-3.5 pl-4 text-zinc-400 font-medium align-top">Primary Audience</td>
              <td class="p-3.5 border-l border-zinc-800/80 align-top text-zinc-300 leading-snug">
                <p class="line-clamp-3 overflow-hidden">{toolA.best_for}</p>
              </td>
              <td class="p-3.5 pr-4 border-l border-zinc-800/80 align-top text-zinc-300 leading-snug">
                <p class="line-clamp-3 overflow-hidden">{toolB.best_for}</p>
              </td>
            </tr>

            <!-- Platforms (Capped to prevent overflow) -->
            <tr class="hover:bg-zinc-900/40 transition-colors">
              <td class="p-3.5 pl-4 text-zinc-400 font-medium align-top">Platforms</td>
              <td class="p-3.5 border-l border-zinc-800/80 align-top">
                <div class="flex flex-wrap gap-1">
                  {toolAPlatforms.map((p) => (
                    <span class="px-1.5 py-0.5 rounded bg-zinc-850 text-zinc-400 text-[10px] font-mono border border-zinc-750">
                      {p}
                    </span>
                  ))}
                  {toolAPlatformsExtra > 0 && (
                    <span class="px-1.5 py-0.5 rounded bg-zinc-800 text-zinc-500 text-[10px] font-mono">
                      +{toolAPlatformsExtra}
                    </span>
                  )}
                </div>
              </td>
              <td class="p-3.5 pr-4 border-l border-zinc-800/80 align-top">
                <div class="flex flex-wrap gap-1">
                  {toolBPlatforms.map((p) => (
                    <span class="px-1.5 py-0.5 rounded bg-zinc-850 text-zinc-400 text-[10px] font-mono border border-zinc-750">
                      {p}
                    </span>
                  ))}
                  {toolBPlatformsExtra > 0 && (
                    <span class="px-1.5 py-0.5 rounded bg-zinc-800 text-zinc-500 text-[10px] font-mono">
                      +{toolBPlatformsExtra}
                    </span>
                  )}
                </div>
              </td>
            </tr>

            <!-- Positioning / Tagline -->
            <tr class="hover:bg-zinc-900/40 transition-colors">
              <td class="p-3.5 pl-4 text-zinc-400 font-medium align-top">Core Positioning</td>
              <td class="p-3.5 border-l border-zinc-800/80 align-top text-zinc-400 text-[11px] leading-snug">
                <p class="line-clamp-2 overflow-hidden">{toolA.tagline}</p>
              </td>
              <td class="p-3.5 pr-4 border-l border-zinc-800/80 align-top text-zinc-400 text-[11px] leading-snug">
                <p class="line-clamp-2 overflow-hidden">{toolB.tagline}</p>
              </td>
            </tr>

            <!-- Key Features (Strictly 4 bullet points max) -->
            <tr class="hover:bg-zinc-900/40 transition-colors">
              <td class="p-3.5 pl-4 text-zinc-400 font-medium align-top">Key Capabilities</td>
              <td class="p-3.5 border-l border-zinc-800/80 align-top">
                <ul class="space-y-1.5 text-zinc-300 text-xs">
                  {toolAFeatures.map((f) => (
                    <li class="flex items-start gap-1.5">
                      <span class="text-zinc-600 font-mono select-none">›</span>
                      <span class="line-clamp-2 leading-snug">{f}</span>
                    </li>
                  ))}
                </ul>
              </td>
              <td class="p-3.5 pr-4 border-l border-zinc-800/80 align-top">
                <ul class="space-y-1.5 text-zinc-300 text-xs">
                  {toolBFeatures.map((f) => (
                    <li class="flex items-start gap-1.5">
                      <span class="text-zinc-600 font-mono select-none">›</span>
                      <span class="line-clamp-2 leading-snug">{f}</span>
                    </li>
                  ))}
                </ul>
              </td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>

    <!-- 4. True Git Diff-Style Pros & Cons -->
    <section class="mb-12">
      <div class="mb-3">
        <h2 class="text-xs font-mono uppercase font-bold text-zinc-300 tracking-wider flex items-center gap-2">
          <span>Git Diff Spec Analysis</span>
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <!-- Diff Column A -->
        <div class="rounded-lg border border-zinc-800 overflow-hidden bg-[#0d0d10]">
          <!-- Commit / File Header -->
          <div class="bg-zinc-900 px-3.5 py-2 border-b border-zinc-800 flex items-center justify-between text-xs font-mono">
            <span class="text-zinc-300 font-semibold truncate">diff --git a/{toolA.slug}</span>
            <span class="text-[11px] text-zinc-500 shrink-0">{toolA.pricing_model}</span>
          </div>

          <!-- Diff Body -->
          <div class="divide-y divide-zinc-900/60 font-mono text-xs">
            <!-- Pros (Additions) Header -->
            <div class="px-3 py-1 bg-zinc-900/70 text-zinc-500 text-[11px]">
              @@ strengths (pros) @@
            </div>
            {toolAPros.map((pro) => (
              <div class="flex items-start gap-2.5 px-3 py-1.5 bg-emerald-950/20 text-emerald-300 border-l-2 border-emerald-500">
                <span class="select-none font-bold text-emerald-400 shrink-0">+</span>
                <span class="font-sans text-xs text-zinc-200 leading-snug line-clamp-2">{pro}</span>
              </div>
            ))}

            <!-- Cons (Deletions) Header -->
            <div class="px-3 py-1 bg-zinc-900/70 text-zinc-500 text-[11px]">
              @@ trade-offs (cons) @@
            </div>
            {toolACons.map((con) => (
              <div class="flex items-start gap-2.5 px-3 py-1.5 bg-rose-950/20 text-rose-300 border-l-2 border-rose-500/80">
                <span class="select-none font-bold text-rose-400 shrink-0">-</span>
                <span class="font-sans text-xs text-zinc-300 leading-snug line-clamp-2">{con}</span>
              </div>
            ))}
          </div>

          <div class="p-3 bg-zinc-900/40 border-t border-zinc-800">
            <a
              href={toolA.affiliate_url}
              target="_blank"
              rel="noopener noreferrer"
              class="w-full py-1.5 px-3 rounded bg-zinc-850 hover:bg-zinc-800 text-zinc-200 hover:text-white border border-zinc-750 text-xs font-mono text-center flex items-center justify-center gap-1.5 transition-colors"
            >
              <span>Explore {toolA.name}</span>
              <span>↗</span>
            </a>
          </div>
        </div>

        <!-- Diff Column B -->
        <div class="rounded-lg border border-zinc-800 overflow-hidden bg-[#0d0d10]">
          <!-- Commit / File Header -->
          <div class="bg-zinc-900 px-3.5 py-2 border-b border-zinc-800 flex items-center justify-between text-xs font-mono">
            <span class="text-zinc-300 font-semibold truncate">diff --git b/{toolB.slug}</span>
            <span class="text-[11px] text-zinc-500 shrink-0">{toolB.pricing_model}</span>
          </div>

          <!-- Diff Body -->
          <div class="divide-y divide-zinc-900/60 font-mono text-xs">
            <!-- Pros (Additions) Header -->
            <div class="px-3 py-1 bg-zinc-900/70 text-zinc-500 text-[11px]">
              @@ strengths (pros) @@
            </div>
            {toolBPros.map((pro) => (
              <div class="flex items-start gap-2.5 px-3 py-1.5 bg-emerald-950/20 text-emerald-300 border-l-2 border-emerald-500">
                <span class="select-none font-bold text-emerald-400 shrink-0">+</span>
                <span class="font-sans text-xs text-zinc-200 leading-snug line-clamp-2">{pro}</span>
              </div>
            ))}

            <!-- Cons (Deletions) Header -->
            <div class="px-3 py-1 bg-zinc-900/70 text-zinc-500 text-[11px]">
              @@ trade-offs (cons) @@
            </div>
            {toolBCons.map((con) => (
              <div class="flex items-start gap-2.5 px-3 py-1.5 bg-rose-950/20 text-rose-300 border-l-2 border-rose-500/80">
                <span class="select-none font-bold text-rose-400 shrink-0">-</span>
                <span class="font-sans text-xs text-zinc-300 leading-snug line-clamp-2">{con}</span>
              </div>
            ))}
          </div>

          <div class="p-3 bg-zinc-900/40 border-t border-zinc-800">
            <a
              href={toolB.affiliate_url}
              target="_blank"
              rel="noopener noreferrer"
              class="w-full py-1.5 px-3 rounded bg-zinc-850 hover:bg-zinc-800 text-zinc-200 hover:text-white border border-zinc-750 text-xs font-mono text-center flex items-center justify-center gap-1.5 transition-colors"
            >
              <span>Explore {toolB.name}</span>
              <span>↗</span>
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- 5. Minimal High-Contrast CTA Section -->
    <section class="mb-12 p-6 rounded-lg bg-[#121215] border border-zinc-800 text-center">
      <h3 class="text-lg font-bold text-white mb-2">Ready to test these models?</h3>
      <p class="text-xs text-zinc-400 max-w-lg mx-auto mb-5">
        Both tools provide developer APIs and standard tiers. Test directly with verified pricing and free allocations.
      </p>

      <div class="flex flex-col sm:flex-row items-center justify-center gap-3 max-w-sm mx-auto">
        <a
          href={toolA.affiliate_url}
          target="_blank"
          rel="noopener noreferrer"
          class="w-full sm:w-auto flex-1 py-2.5 px-4 rounded bg-white text-zinc-950 hover:bg-zinc-200 font-semibold text-xs font-mono transition-colors flex items-center justify-center gap-1"
        >
          <span>Try {toolA.name}</span>
          <span>↗</span>
        </a>

        <a
          href={toolB.affiliate_url}
          target="_blank"
          rel="noopener noreferrer"
          class="w-full sm:w-auto flex-1 py-2.5 px-4 rounded bg-zinc-850 hover:bg-zinc-800 text-zinc-200 hover:text-white border border-zinc-750 font-semibold text-xs font-mono transition-colors flex items-center justify-center gap-1"
        >
          <span>Try {toolB.name}</span>
          <span>↗</span>
        </a>
      </div>
    </section>

    <!-- 6. Category Internal Linking Mesh (pSEO) -->
    {relatedTools.length > 0 && (
      <section class="border-t border-zinc-800/80 pt-8">
        <h3 class="text-xs font-mono uppercase tracking-wider text-zinc-400 font-semibold mb-3">
          More {category} Comparisons
        </h3>
        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-2.5">
          {relatedTools.slice(0, 6).map((other) => {
            const [first, second] = [toolA, other].sort((a, b) => a.slug.localeCompare(b.slug));
            const otherSlug = `${first.slug}-vs-${second.slug}`;
            return (
              <a
                href={`/compare/${otherSlug}`}
                class="p-2.5 rounded bg-zinc-900/60 border border-zinc-800 hover:border-zinc-700 hover:bg-zinc-850 transition-colors flex items-center justify-between text-xs group"
              >
                <span class="text-zinc-300 group-hover:text-white truncate">
                  {first.name} <span class="text-zinc-500 font-mono">vs</span> {second.name}
                </span>
                <span class="text-zinc-500 group-hover:text-zinc-300 font-mono">↗</span>
              </a>
            );
          })}
        </div>
      </section>
    )}

  </div>
</Layout>
