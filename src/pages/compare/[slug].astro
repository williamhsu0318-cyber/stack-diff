---
import Layout from '../../layouts/Layout.astro';
import toolsData from '../../data/tools.json';

export interface ToolItem {
  id: string;
  name: string;
  slug: string;
  category: string;
  tagline: string;
  pricing_model: string;
  starting_price: string;
  free_tier: boolean;
  best_for: string;
  key_features: string[];
  pros: string[];
  cons: string[];
  supported_platforms: string[];
  affiliate_url: string;
}

export async function getStaticPaths() {
  const tools = toolsData as ToolItem[];

  // Group tools strictly by category
  const categoryMap = new Map<string, ToolItem[]>();
  for (const tool of tools) {
    if (!categoryMap.has(tool.category)) {
      categoryMap.set(tool.category, []);
    }
    categoryMap.get(tool.category)!.push(tool);
  }

  const paths = [];

  for (const [category, groupTools] of categoryMap.entries()) {
    if (groupTools.length < 2) continue;

    for (let i = 0; i < groupTools.length; i++) {
      for (let j = i + 1; j < groupTools.length; j++) {
        const item1 = groupTools[i];
        const item2 = groupTools[j];

        // Alphabetical ordering to prevent duplicate reciprocal URLs
        const [toolA, toolB] = [item1, item2].sort((a, b) =>
          a.slug.localeCompare(b.slug)
        );

        const slug = `${toolA.slug}-vs-${toolB.slug}`;

        // Find all other tools in the same category for the internal linking matrix
        const siblingTools = groupTools.filter(
          (t) => t.id !== toolA.id && t.id !== toolB.id
        );

        paths.push({
          params: { slug },
          props: {
            toolA,
            toolB,
            category,
            siblingTools,
            allCategoryTools: groupTools,
          },
        });
      }
    }
  }

  return paths;
}

interface Props {
  toolA: ToolItem;
  toolB: ToolItem;
  category: string;
  siblingTools: ToolItem[];
  allCategoryTools: ToolItem[];
}

const { toolA, toolB, category, siblingTools = [], allCategoryTools = [] } = Astro.props;

// Data limitation logic: Cap items to prevent layout clutter and text overlap
const maxFeatures = 4;
const maxPros = 3;
const maxCons = 3;
const maxPlatforms = 4;

const toolAFeatures = toolA.key_features.slice(0, maxFeatures);
const toolBFeatures = toolB.key_features.slice(0, maxFeatures);

const toolAPros = toolA.pros.slice(0, maxPros);
const toolBPros = toolB.pros.slice(0, maxPros);

const toolACons = toolA.cons.slice(0, maxCons);
const toolBCons = toolB.cons.slice(0, maxCons);

const toolAPlatforms = toolA.supported_platforms.slice(0, maxPlatforms);
const toolAPlatformsExtra = toolA.supported_platforms.length - maxPlatforms;

const toolBPlatforms = toolB.supported_platforms.slice(0, maxPlatforms);
const toolBPlatformsExtra = toolB.supported_platforms.length - maxPlatforms;

// SEO Metadata
const pageTitle = `${toolA.name} vs ${toolB.name} (2026): In-Depth Comparison, Pricing & Verdict | StackDiff`;
const pageDescription = `Compare ${toolA.name} and ${toolB.name}. See full side-by-side feature matrix, pricing differences, pros & cons, and which ${category} tool is right for you.`;
const canonicalUrl = `https://stackdiff.pages.dev/compare/${toolA.slug}-vs-${toolB.slug}`;

// Generate 3-4 recommended related comparisons in the same category for the Internal Linking Mesh
interface RelatedDiff {
  slug: string;
  nameA: string;
  nameB: string;
  priceA: string;
  priceB: string;
}

const relatedComparisons: RelatedDiff[] = [];

// 1. First pair Tool A with another sibling
for (const sib of siblingTools) {
  if (relatedComparisons.length >= 4) break;
  const [f, s] = [toolA, sib].sort((a, b) => a.slug.localeCompare(b.slug));
  const rSlug = `${f.slug}-vs-${s.slug}`;
  if (!relatedComparisons.some((r) => r.slug === rSlug)) {
    relatedComparisons.push({
      slug: rSlug,
      nameA: f.name,
      nameB: s.name,
      priceA: f.starting_price,
      priceB: s.starting_price,
    });
  }
}

// 2. Pair Tool B with another sibling if slots remain
for (const sib of siblingTools) {
  if (relatedComparisons.length >= 4) break;
  const [f, s] = [toolB, sib].sort((a, b) => a.slug.localeCompare(b.slug));
  const rSlug = `${f.slug}-vs-${s.slug}`;
  if (!relatedComparisons.some((r) => r.slug === rSlug)) {
    relatedComparisons.push({
      slug: rSlug,
      nameA: f.name,
      nameB: s.name,
      priceA: f.starting_price,
      priceB: s.starting_price,
    });
  }
}

// Google Rich Snippets: Enhanced Schema.org JSON-LD (SoftwareApplication + Article)
const numericPriceA = toolA.starting_price.replace(/[^0-9.]/g, '') || "0";
const numericPriceB = toolB.starting_price.replace(/[^0-9.]/g, '') || "0";

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Article",
      "@id": `${canonicalUrl}#article`,
      "isPartOf": {
        "@type": "WebSite",
        "@id": "https://stackdiff.pages.dev/#website",
        "name": "StackDiff",
        "url": "https://stackdiff.pages.dev"
      },
      "headline": `${toolA.name} vs ${toolB.name} (2026 Comparison & Specs)`,
      "description": pageDescription,
      "datePublished": "2026-01-15T08:00:00+08:00",
      "dateModified": "2026-09-02T17:00:00+08:00",
      "author": {
        "@type": "Organization",
        "name": "StackDiff Technical Review Team",
        "url": "https://stackdiff.pages.dev"
      },
      "publisher": {
        "@type": "Organization",
        "name": "StackDiff",
        "url": "https://stackdiff.pages.dev"
      }
    },
    {
      "@type": "SoftwareApplication",
      "name": toolA.name,
      "applicationCategory": toolA.category,
      "operatingSystem": toolA.supported_platforms.join(", "),
      "description": toolA.tagline,
      "offers": {
        "@type": "Offer",
        "price": numericPriceA,
        "priceCurrency": "USD",
        "priceValidUntil": "2027-01-01",
        "availability": "https://schema.org/InStock"
      }
    },
    {
      "@type": "SoftwareApplication",
      "name": toolB.name,
      "applicationCategory": toolB.category,
      "operatingSystem": toolB.supported_platforms.join(", "),
      "description": toolB.tagline,
      "offers": {
        "@type": "Offer",
        "price": numericPriceB,
        "priceCurrency": "USD",
        "priceValidUntil": "2027-01-01",
        "availability": "https://schema.org/InStock"
      }
    }
  ]
};
---

<Layout title={pageTitle} description={pageDescription} canonicalUrl={canonicalUrl} jsonLd={jsonLd}>
  <div class="max-w-5xl mx-auto px-4 sm:px-6 py-6 md:py-8">
    
    <!-- 1. Breadcrumbs -->
    <nav class="flex items-center gap-1.5 text-[11px] text-zinc-500 font-mono mb-6" aria-label="Breadcrumb">
      <a href="/" class="hover:text-zinc-300 transition-colors">Home</a>
      <span>/</span>
      <a href="/#categories" class="hover:text-zinc-300 transition-colors">{category}</a>
      <span>/</span>
      <span class="text-zinc-200">{toolA.name} vs {toolB.name}</span>
    </nav>

    <!-- 2. Hero & Quick Verdict Header -->
    <header class="mb-8">
      <div class="flex items-center gap-2 mb-3">
        <span class="text-[11px] font-mono px-2 py-0.5 rounded bg-zinc-900 text-zinc-400 border border-zinc-800">
          {category}
        </span>
        <span class="text-zinc-700">•</span>
        <span class="text-[11px] font-mono text-zinc-500">2026 Spec Matrix</span>
      </div>

      <!-- Duel Title -->
      <h1 class="text-2xl sm:text-3xl md:text-4xl font-bold tracking-tight text-white mb-6">
        {toolA.name} <span class="text-zinc-500 font-light px-1">vs</span> {toolB.name}
      </h1>

      <!-- The Bottom Line Verdict (Immediate, High Visibility) -->
      <div class="p-4 sm:p-5 rounded-lg bg-[#121215] border border-zinc-800 mb-6 shadow-sm">
        <div class="flex items-center gap-2 mb-2 font-mono text-xs font-semibold uppercase tracking-wider text-zinc-300">
          <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
          <span>The Bottom Line Verdict</span>
        </div>
        <div class="grid sm:grid-cols-2 gap-4 text-xs sm:text-sm text-zinc-300 leading-relaxed divide-y sm:divide-y-0 sm:divide-x divide-zinc-800">
          <div class="pt-2 sm:pt-0 sm:pr-4">
            <span class="font-semibold text-white">Choose {toolA.name}:</span>
            <span class="text-zinc-400 ml-1 line-clamp-2 leading-relaxed">{toolA.best_for}.</span>
          </div>
          <div class="pt-3 sm:pt-0 sm:pl-4">
            <span class="font-semibold text-white">Choose {toolB.name}:</span>
            <span class="text-zinc-400 ml-1 line-clamp-2 leading-relaxed">{toolB.best_for}.</span>
          </div>
        </div>
      </div>

      <!-- Compact Duel Action Cards -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
        <!-- Card Tool A -->
        <div class="p-4 rounded-lg bg-[#121215] border border-zinc-800 flex items-center justify-between gap-4 shadow-sm hover:border-zinc-700 transition-colors">
          <div class="min-w-0">
            <div class="flex items-center gap-2 mb-1">
              <span class="font-bold text-white text-base truncate">{toolA.name}</span>
              <span class="text-[10px] font-mono px-1.5 py-0.2 rounded bg-zinc-850 text-zinc-400 border border-zinc-750">
                {toolA.pricing_model}
              </span>
            </div>
            <div class="flex items-baseline gap-2">
              <span class="text-lg font-mono font-bold text-white">{toolA.starting_price}</span>
              <span class="text-[11px] font-mono text-zinc-500">
                {toolA.free_tier ? 'Free tier available' : 'Paid only'}
              </span>
            </div>
          </div>
          <a
            href={toolA.affiliate_url}
            target="_blank"
            rel="noopener noreferrer nofollow"
            class="shrink-0 px-3.5 py-2 rounded-md bg-white text-zinc-950 hover:bg-zinc-200 text-xs font-semibold font-mono flex items-center gap-1.5 shadow-sm transition-all hover:shadow-zinc-700/20"
          >
            <span>Try {toolA.name} Official</span>
            <span>↗</span>
          </a>
        </div>

        <!-- Card Tool B -->
        <div class="p-4 rounded-lg bg-[#121215] border border-zinc-800 flex items-center justify-between gap-4 shadow-sm hover:border-zinc-700 transition-colors">
          <div class="min-w-0">
            <div class="flex items-center gap-2 mb-1">
              <span class="font-bold text-white text-base truncate">{toolB.name}</span>
              <span class="text-[10px] font-mono px-1.5 py-0.2 rounded bg-zinc-850 text-zinc-400 border border-zinc-750">
                {toolB.pricing_model}
              </span>
            </div>
            <div class="flex items-baseline gap-2">
              <span class="text-lg font-mono font-bold text-white">{toolB.starting_price}</span>
              <span class="text-[11px] font-mono text-zinc-500">
                {toolB.free_tier ? 'Free tier available' : 'Paid only'}
              </span>
            </div>
          </div>
          <a
            href={toolB.affiliate_url}
            target="_blank"
            rel="noopener noreferrer nofollow"
            class="shrink-0 px-3.5 py-2 rounded-md bg-zinc-850 hover:bg-zinc-800 text-zinc-100 hover:text-white text-xs font-semibold font-mono border border-zinc-750 flex items-center gap-1.5 transition-colors"
          >
            <span>Try {toolB.name} Official</span>
            <span>↗</span>
          </a>
        </div>
      </div>
    </header>

    <!-- 3. Core Spec Comparison Matrix (Mobile-Responsive, Sticky Header, Anti-Cramp) -->
    <section class="mb-12">
      <div class="flex items-center justify-between mb-3">
        <h2 class="text-xs font-mono uppercase font-bold text-zinc-400 tracking-wider">
          Side-by-Side Matrix Table
        </h2>
        <span class="text-[11px] font-mono text-zinc-500 sm:hidden">Swipe horizontally &rarr;</span>
      </div>

      <!-- Mobile overflow-x-auto container -->
      <div class="overflow-x-auto -mx-4 sm:mx-0 px-4 sm:px-0">
        <div class="inline-block min-w-full align-middle border border-zinc-800 rounded-lg bg-[#121215] overflow-hidden shadow-sm">
          <table class="w-full text-left border-collapse table-fixed min-w-[580px]">
            <colgroup>
              <col class="w-[24%]" />
              <col class="w-[38%]" />
              <col class="w-[38%]" />
            </colgroup>

            <!-- Sticky Table Header (Pinned when scrolling) -->
            <thead class="sticky top-14 z-20 bg-[#09090b]/95 backdrop-blur-md border-b border-zinc-800 shadow-sm">
              <tr class="text-[11px] font-mono text-zinc-400">
                <th class="p-3.5 sm:p-4 pl-4 text-zinc-500 font-normal">SPECIFICATION</th>
                <th class="p-3.5 sm:p-4 border-l border-zinc-800">
                  <div class="flex items-center justify-between gap-2">
                    <span class="font-bold text-white text-xs truncate">{toolA.name}</span>
                    <span class="text-[11px] font-mono text-zinc-300 bg-zinc-850 px-1.5 py-0.5 rounded border border-zinc-750 shrink-0">
                      {toolA.starting_price}
                    </span>
                  </div>
                </th>
                <th class="p-3.5 sm:p-4 pr-4 border-l border-zinc-800">
                  <div class="flex items-center justify-between gap-2">
                    <span class="font-bold text-white text-xs truncate">{toolB.name}</span>
                    <span class="text-[11px] font-mono text-zinc-300 bg-zinc-850 px-1.5 py-0.5 rounded border border-zinc-750 shrink-0">
                      {toolB.starting_price}
                    </span>
                  </div>
                </th>
              </tr>
            </thead>

            <tbody class="divide-y divide-zinc-800/70 text-xs">
              <!-- Starting Price -->
              <tr class="hover:bg-zinc-900/40 transition-colors">
                <td class="p-3.5 sm:p-4 pl-4 text-zinc-400 font-medium align-top">Starting Price</td>
                <td class="p-3.5 sm:p-4 border-l border-zinc-800 align-top">
                  <span class="text-sm font-bold font-mono text-white block">{toolA.starting_price}</span>
                </td>
                <td class="p-3.5 sm:p-4 pr-4 border-l border-zinc-800 align-top">
                  <span class="text-sm font-bold font-mono text-white block">{toolB.starting_price}</span>
                </td>
              </tr>

              <!-- Pricing Model -->
              <tr class="hover:bg-zinc-900/40 transition-colors">
                <td class="p-3.5 sm:p-4 pl-4 text-zinc-400 font-medium align-top">Pricing Model</td>
                <td class="p-3.5 sm:p-4 border-l border-zinc-800 align-top">
                  <span class="inline-block px-2 py-0.5 rounded text-[11px] font-mono bg-zinc-850 text-zinc-300 border border-zinc-750">
                    {toolA.pricing_model}
                  </span>
                </td>
                <td class="p-3.5 sm:p-4 pr-4 border-l border-zinc-800 align-top">
                  <span class="inline-block px-2 py-0.5 rounded text-[11px] font-mono bg-zinc-850 text-zinc-300 border border-zinc-750">
                    {toolB.pricing_model}
                  </span>
                </td>
              </tr>

              <!-- Free Tier -->
              <tr class="hover:bg-zinc-900/40 transition-colors">
                <td class="p-3.5 sm:p-4 pl-4 text-zinc-400 font-medium align-top">Free Tier / Trial</td>
                <td class="p-3.5 sm:p-4 border-l border-zinc-800 align-top font-mono text-[11px]">
                  {toolA.free_tier ? (
                    <span class="text-emerald-400 flex items-center gap-1 font-medium">
                      <span>✓</span> Permanent Free Quota
                    </span>
                  ) : (
                    <span class="text-zinc-500 flex items-center gap-1">
                      <span>✕</span> Paid Only (No Free Tier)
                    </span>
                  )}
                </td>
                <td class="p-3.5 sm:p-4 pr-4 border-l border-zinc-800 align-top font-mono text-[11px]">
                  {toolB.free_tier ? (
                    <span class="text-emerald-400 flex items-center gap-1 font-medium">
                      <span>✓</span> Permanent Free Quota
                    </span>
                  ) : (
                    <span class="text-zinc-500 flex items-center gap-1">
                      <span>✕</span> Paid Only (No Free Tier)
                    </span>
                  )}
                </td>
              </tr>

              <!-- Best For (ICP) -->
              <tr class="hover:bg-zinc-900/40 transition-colors">
                <td class="p-3.5 sm:p-4 pl-4 text-zinc-400 font-medium align-top">Target Audience</td>
                <td class="p-3.5 sm:p-4 border-l border-zinc-800 align-top text-zinc-300 leading-relaxed">
                  <p class="line-clamp-3 overflow-hidden break-words">{toolA.best_for}</p>
                </td>
                <td class="p-3.5 sm:p-4 pr-4 border-l border-zinc-800 align-top text-zinc-300 leading-relaxed">
                  <p class="line-clamp-3 overflow-hidden break-words">{toolB.best_for}</p>
                </td>
              </tr>

              <!-- Platforms -->
              <tr class="hover:bg-zinc-900/40 transition-colors">
                <td class="p-3.5 sm:p-4 pl-4 text-zinc-400 font-medium align-top">Platforms</td>
                <td class="p-3.5 sm:p-4 border-l border-zinc-800 align-top">
                  <div class="flex flex-wrap gap-1">
                    {toolAPlatforms.map((p) => (
                      <span class="px-1.5 py-0.5 rounded bg-zinc-850 text-zinc-400 text-[10px] font-mono border border-zinc-750">
                        {p}
                      </span>
                    ))}
                    {toolAPlatformsExtra > 0 && (
                      <span class="px-1.5 py-0.5 rounded bg-zinc-800 text-zinc-500 text-[10px] font-mono">
                        +{toolAPlatformsExtra}
                      </span>
                    )}
                  </div>
                </td>
                <td class="p-3.5 sm:p-4 pr-4 border-l border-zinc-800 align-top">
                  <div class="flex flex-wrap gap-1">
                    {toolBPlatforms.map((p) => (
                      <span class="px-1.5 py-0.5 rounded bg-zinc-850 text-zinc-400 text-[10px] font-mono border border-zinc-750">
                        {p}
                      </span>
                    ))}
                    {toolBPlatformsExtra > 0 && (
                      <span class="px-1.5 py-0.5 rounded bg-zinc-800 text-zinc-500 text-[10px] font-mono">
                        +{toolBPlatformsExtra}
                      </span>
                    )}
                  </div>
                </td>
              </tr>

              <!-- Core Positioning Tagline -->
              <tr class="hover:bg-zinc-900/40 transition-colors">
                <td class="p-3.5 sm:p-4 pl-4 text-zinc-400 font-medium align-top">Core Positioning</td>
                <td class="p-3.5 sm:p-4 border-l border-zinc-800 align-top text-zinc-400 text-[11px] leading-relaxed">
                  <p class="line-clamp-2 overflow-hidden break-words">{toolA.tagline}</p>
                </td>
                <td class="p-3.5 sm:p-4 pr-4 border-l border-zinc-800 align-top text-zinc-400 text-[11px] leading-relaxed">
                  <p class="line-clamp-2 overflow-hidden break-words">{toolB.tagline}</p>
                </td>
              </tr>

              <!-- Key Features -->
              <tr class="hover:bg-zinc-900/40 transition-colors">
                <td class="p-3.5 sm:p-4 pl-4 text-zinc-400 font-medium align-top">Key Capabilities</td>
                <td class="p-3.5 sm:p-4 border-l border-zinc-800 align-top">
                  <ul class="space-y-2 text-zinc-300 text-xs">
                    {toolAFeatures.map((f) => (
                      <li class="flex items-start gap-1.5">
                        <span class="text-zinc-500 font-mono select-none shrink-0">›</span>
                        <span class="line-clamp-2 leading-relaxed break-words">{f}</span>
                      </li>
                    ))}
                  </ul>
                </td>
                <td class="p-3.5 sm:p-4 pr-4 border-l border-zinc-800 align-top">
                  <ul class="space-y-2 text-zinc-300 text-xs">
                    {toolBFeatures.map((f) => (
                      <li class="flex items-start gap-1.5">
                        <span class="text-zinc-500 font-mono select-none shrink-0">›</span>
                        <span class="line-clamp-2 leading-relaxed break-words">{f}</span>
                      </li>
                    ))}
                  </ul>
                </td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- 4. True Git Diff-Style Pros & Cons -->
    <section class="mb-12">
      <div class="mb-3">
        <h2 class="text-xs font-mono uppercase font-bold text-zinc-400 tracking-wider">
          Git Diff Spec Analysis
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <!-- Diff Column A -->
        <div class="rounded-lg border border-zinc-800 overflow-hidden bg-[#0d0d10] shadow-sm">
          <!-- Commit Header -->
          <div class="bg-zinc-900 px-3.5 py-2 border-b border-zinc-800 flex items-center justify-between text-xs font-mono">
            <span class="text-zinc-300 font-semibold truncate">diff --git a/{toolA.slug}</span>
            <span class="text-[11px] text-zinc-500 shrink-0">{toolA.pricing_model}</span>
          </div>

          <!-- Diff Body -->
          <div class="divide-y divide-zinc-900/80 font-mono text-xs">
            <div class="px-3 py-1 bg-zinc-900/60 text-zinc-500 text-[10px]">
              @@ strengths (pros) @@
            </div>
            {toolAPros.map((pro) => (
              <div class="flex items-start gap-2.5 px-3.5 py-2 bg-emerald-950/20 text-emerald-300 border-l-2 border-emerald-500">
                <span class="select-none font-bold text-emerald-400 shrink-0 font-mono">+</span>
                <span class="font-sans text-xs text-zinc-200 leading-relaxed line-clamp-2">{pro}</span>
              </div>
            ))}

            <div class="px-3 py-1 bg-zinc-900/60 text-zinc-500 text-[10px]">
              @@ trade-offs (cons) @@
            </div>
            {toolACons.map((con) => (
              <div class="flex items-start gap-2.5 px-3.5 py-2 bg-zinc-900/50 text-zinc-300 border-l-2 border-zinc-700">
                <span class="select-none font-bold text-zinc-400 shrink-0 font-mono">-</span>
                <span class="font-sans text-xs text-zinc-300 leading-relaxed line-clamp-2">{con}</span>
              </div>
            ))}
          </div>

          <div class="p-3 bg-zinc-900/40 border-t border-zinc-800">
            <a
              href={toolA.affiliate_url}
              target="_blank"
              rel="noopener noreferrer nofollow"
              class="w-full py-1.5 px-3 rounded bg-zinc-850 hover:bg-zinc-800 text-zinc-200 hover:text-white border border-zinc-750 text-xs font-mono text-center flex items-center justify-center gap-1.5 transition-colors"
            >
              <span>Try {toolA.name} Official</span>
              <span>↗</span>
            </a>
          </div>
        </div>

        <!-- Diff Column B -->
        <div class="rounded-lg border border-zinc-800 overflow-hidden bg-[#0d0d10] shadow-sm">
          <!-- Commit Header -->
          <div class="bg-zinc-900 px-3.5 py-2 border-b border-zinc-800 flex items-center justify-between text-xs font-mono">
            <span class="text-zinc-300 font-semibold truncate">diff --git b/{toolB.slug}</span>
            <span class="text-[11px] text-zinc-500 shrink-0">{toolB.pricing_model}</span>
          </div>

          <!-- Diff Body -->
          <div class="divide-y divide-zinc-900/80 font-mono text-xs">
            <div class="px-3 py-1 bg-zinc-900/60 text-zinc-500 text-[10px]">
              @@ strengths (pros) @@
            </div>
            {toolBPros.map((pro) => (
              <div class="flex items-start gap-2.5 px-3.5 py-2 bg-emerald-950/20 text-emerald-300 border-l-2 border-emerald-500">
                <span class="select-none font-bold text-emerald-400 shrink-0 font-mono">+</span>
                <span class="font-sans text-xs text-zinc-200 leading-relaxed line-clamp-2">{pro}</span>
              </div>
            ))}

            <div class="px-3 py-1 bg-zinc-900/60 text-zinc-500 text-[10px]">
              @@ trade-offs (cons) @@
            </div>
            {toolBCons.map((con) => (
              <div class="flex items-start gap-2.5 px-3.5 py-2 bg-zinc-900/50 text-zinc-300 border-l-2 border-zinc-700">
                <span class="select-none font-bold text-zinc-400 shrink-0 font-mono">-</span>
                <span class="font-sans text-xs text-zinc-300 leading-relaxed line-clamp-2">{con}</span>
              </div>
            ))}
          </div>

          <div class="p-3 bg-zinc-900/40 border-t border-zinc-800">
            <a
              href={toolB.affiliate_url}
              target="_blank"
              rel="noopener noreferrer nofollow"
              class="w-full py-1.5 px-3 rounded bg-zinc-850 hover:bg-zinc-800 text-zinc-200 hover:text-white border border-zinc-750 text-xs font-mono text-center flex items-center justify-center gap-1.5 transition-colors"
            >
              <span>Try {toolB.name} Official</span>
              <span>↗</span>
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- 5. High-Conversion Primary CTA Section -->
    <section class="mb-14 p-6 sm:p-8 rounded-lg bg-[#121215] border border-zinc-800 text-center shadow-sm">
      <h3 class="text-base sm:text-lg font-bold text-white mb-1.5">Ready to verify these models on your stack?</h3>
      <p class="text-xs text-zinc-400 max-w-md mx-auto mb-6 leading-relaxed">
        Test API latencies, quota models, and commercial outputs directly on official platforms.
      </p>

      <div class="flex flex-col sm:flex-row items-center justify-center gap-3 max-w-sm mx-auto">
        <a
          href={toolA.affiliate_url}
          target="_blank"
          rel="noopener noreferrer nofollow"
          class="w-full sm:w-auto flex-1 py-2.5 px-4 rounded-md bg-white text-zinc-950 hover:bg-zinc-200 font-semibold text-xs font-mono transition-all flex items-center justify-center gap-1.5 shadow-sm hover:shadow-zinc-700/20"
        >
          <span>Try {toolA.name} Official</span>
          <span>↗</span>
        </a>

        <a
          href={toolB.affiliate_url}
          target="_blank"
          rel="noopener noreferrer nofollow"
          class="w-full sm:w-auto flex-1 py-2.5 px-4 rounded-md bg-zinc-850 hover:bg-zinc-800 text-zinc-200 hover:text-white border border-zinc-750 font-semibold text-xs font-mono transition-colors flex items-center justify-center gap-1.5"
        >
          <span>Try {toolB.name} Official</span>
          <span>↗</span>
        </a>
      </div>
    </section>

    <!-- 6. Category Internal Linking Mesh (3-4 Recommended Pairings in Same Category) -->
    {relatedComparisons.length > 0 && (
      <section class="border-t border-zinc-800/80 pt-8">
        <div class="flex items-center justify-between mb-3">
          <h3 class="text-xs font-mono uppercase tracking-wider text-zinc-400 font-semibold">
            Related Comparisons in {category}
          </h3>
          <span class="text-[11px] font-mono text-zinc-500">SEO Link Cluster</span>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-2.5">
          {relatedComparisons.map((item) => (
            <a
              href={`/compare/${item.slug}`}
              class="p-3 rounded bg-zinc-900/60 border border-zinc-800 hover:border-zinc-700 hover:bg-zinc-850 transition-colors flex flex-col justify-between text-xs group"
            >
              <div class="font-medium text-zinc-200 group-hover:text-white truncate mb-1.5">
                {item.nameA} <span class="text-zinc-500 font-mono text-[11px]">vs</span> {item.nameB}
              </div>
              <div class="flex items-center justify-between text-[10px] font-mono text-zinc-500">
                <span>{item.priceA} / {item.priceB}</span>
                <span class="group-hover:text-zinc-300">↗</span>
              </div>
            </a>
          ))}
        </div>
      </section>
    )}

  </div>
</Layout>
