---
import Layout from '../../layouts/Layout.astro';
import toolsData from '../../../data/tools.json';

export interface ToolItem {
  id: string;
  name: string;
  slug: string;
  category: string;
  tagline: string;
  pricing_model: string;
  starting_price: string;
  free_tier: boolean;
  best_for: string;
  key_features: string[];
  pros: string[];
  cons: string[];
  supported_platforms: string[];
  affiliate_url: string;
}

export async function getStaticPaths() {
  const tools = toolsData as ToolItem[];

  // Group tools by category
  const categoryMap = new Map<string, ToolItem[]>();
  for (const tool of tools) {
    if (!categoryMap.has(tool.category)) {
      categoryMap.set(tool.category, []);
    }
    categoryMap.get(tool.category)!.push(tool);
  }

  const paths = [];

  // Generate pairwise combinations strictly within the same category
  for (const [category, groupTools] of categoryMap.entries()) {
    if (groupTools.length < 2) continue;

    for (let i = 0; i < groupTools.length; i++) {
      for (let j = i + 1; j < groupTools.length; j++) {
        const item1 = groupTools[i];
        const item2 = groupTools[j];

        // Ensure alphabetical ordering by slug to avoid duplicates (A-vs-B and B-vs-A)
        const [toolA, toolB] = [item1, item2].sort((a, b) =>
          a.slug.localeCompare(b.slug)
        );

        const slug = `${toolA.slug}-vs-${toolB.slug}`;

        // Find other comparisons in the same category for contextual internal linking
        const relatedTools = groupTools.filter(
          (t) => t.id !== toolA.id && t.id !== toolB.id
        );

        paths.push({
          params: { slug },
          props: {
            toolA,
            toolB,
            category,
            relatedTools,
          },
        });
      }
    }
  }

  return paths;
}

interface Props {
  toolA: ToolItem;
  toolB: ToolItem;
  category: string;
  relatedTools: ToolItem[];
}

const { toolA, toolB, category, relatedTools = [] } = Astro.props;

// Required pSEO Meta Tags
const pageTitle = `${toolA.name} vs ${toolB.name} (2026): In-Depth Comparison, Pricing & Verdict | StackDiff`;
const pageDescription = `Compare ${toolA.name} and ${toolB.name}. See full side-by-side feature matrix, pricing differences, pros & cons, and which ${category} tool is right for you.`;

// Schema.org Structured Data for Google Rich Snippets
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": `${toolA.name} vs ${toolB.name} (2026 Comparison)`,
  "description": pageDescription,
  "datePublished": "2026-01-15T08:00:00+08:00",
  "dateModified": "2026-09-02T16:00:00+08:00",
  "author": {
    "@type": "Organization",
    "name": "StackDiff Engine"
  },
  "mainEntity": [
    {
      "@type": "SoftwareApplication",
      "name": toolA.name,
      "applicationCategory": toolA.category,
      "offers": {
        "@type": "Offer",
        "price": toolA.starting_price.replace(/[^0-9.]/g, '') || "0",
        "priceCurrency": "USD"
      }
    },
    {
      "@type": "SoftwareApplication",
      "name": toolB.name,
      "applicationCategory": toolB.category,
      "offers": {
        "@type": "Offer",
        "price": toolB.starting_price.replace(/[^0-9.]/g, '') || "0",
        "priceCurrency": "USD"
      }
    }
  ]
};
---

<Layout title={pageTitle} description={pageDescription} jsonLd={jsonLd}>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-8 md:py-12">
    
    <!-- 1. Breadcrumbs -->
    <nav class="flex items-center gap-2 text-xs text-dark-500 font-mono mb-8" aria-label="Breadcrumb">
      <a href="/" class="hover:text-dark-300 transition-colors">Home</a>
      <span>/</span>
      <a href="/#categories" class="hover:text-dark-300 transition-colors">{category}</a>
      <span>/</span>
      <span class="text-brand-cyan">{toolA.name} vs {toolB.name}</span>
    </nav>

    <!-- 2. Hero Section & Quick Verdict -->
    <header class="mb-12">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-brand-indigo/10 border border-brand-indigo/30 text-brand-indigo text-xs font-mono mb-4">
        <span>{category} Diff</span>
        <span class="text-dark-600">•</span>
        <span>Updated for 2026</span>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-12 gap-6 items-center">
        <div class="md:col-span-8">
          <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold text-white tracking-tight leading-tight mb-4">
            <span class="text-transparent bg-clip-text bg-gradient-to-r from-white via-dark-100 to-dark-300">{toolA.name}</span>
            <span class="text-brand-indigo px-2 font-light">vs</span>
            <span class="text-transparent bg-clip-text bg-gradient-to-r from-white via-dark-100 to-dark-300">{toolB.name}</span>
          </h1>
          <p class="text-base sm:text-lg text-dark-400 leading-relaxed max-w-2xl">
            A comprehensive, data-backed comparison between <strong class="text-white">{toolA.name}</strong> and <strong class="text-white">{toolB.name}</strong>. Compare specs, pricing models, key capabilities, and find out which solution fits your workflow.
          </p>
        </div>

        <!-- Mini Score / Matchup Badge -->
        <div class="md:col-span-4 flex justify-start md:justify-end">
          <div class="flex items-center gap-3 p-4 rounded-xl bg-dark-900 border border-dark-800 shadow-xl w-full sm:w-auto">
            <div class="text-center px-3 py-2 bg-dark-850 rounded-lg border border-dark-750">
              <div class="text-xs text-dark-400 font-mono">Tool A</div>
              <div class="text-sm font-bold text-white truncate max-w-[100px]">{toolA.name}</div>
              <div class="text-[11px] font-mono text-brand-cyan">{toolA.starting_price}</div>
            </div>
            <div class="font-mono text-xs text-dark-500 font-bold">VS</div>
            <div class="text-center px-3 py-2 bg-dark-850 rounded-lg border border-dark-750">
              <div class="text-xs text-dark-400 font-mono">Tool B</div>
              <div class="text-sm font-bold text-white truncate max-w-[100px]">{toolB.name}</div>
              <div class="text-[11px] font-mono text-brand-violet">{toolB.starting_price}</div>
            </div>
          </div>
        </div>
      </div>

      <!-- Quick Verdict Callout -->
      <div class="mt-8 p-6 rounded-2xl bg-gradient-to-r from-brand-indigo/10 via-dark-900 to-brand-cyan/10 border border-brand-indigo/20 shadow-2xl relative overflow-hidden">
        <div class="flex items-start gap-4">
          <div class="p-2.5 rounded-xl bg-brand-indigo/20 text-brand-indigo border border-brand-indigo/30 shrink-0">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
            </svg>
          </div>
          <div>
            <h3 class="text-sm font-bold uppercase tracking-wider text-brand-cyan font-mono mb-1">
              The 30-Second Verdict
            </h3>
            <p class="text-sm sm:text-base text-dark-200 leading-relaxed">
              Choose <strong class="text-white underline decoration-brand-indigo underline-offset-4">{toolA.name}</strong> if you are focused on <span class="text-white">{toolA.best_for}</span>.
              Conversely, pick <strong class="text-white underline decoration-brand-cyan underline-offset-4">{toolB.name}</strong> if your primary objective is <span class="text-white">{toolB.best_for}</span>.
            </p>
          </div>
        </div>
      </div>
    </header>

    <!-- 3. Core Spec Comparison Matrix -->
    <section class="mb-14">
      <div class="flex items-center justify-between mb-6">
        <div>
          <h2 class="text-xl sm:text-2xl font-bold text-white tracking-tight">Side-by-Side Comparison Matrix</h2>
          <p class="text-xs sm:text-sm text-dark-400">Technical specifications, commercial terms, and feature readiness</p>
        </div>
        <span class="text-xs font-mono text-dark-500 hidden sm:inline-block">2026 Spec Sheet</span>
      </div>

      <div class="overflow-x-auto rounded-2xl border border-dark-800 bg-dark-900/90 shadow-2xl">
        <table class="w-full text-left border-collapse">
          <thead>
            <tr class="border-b border-dark-800 bg-dark-850/70 text-xs font-mono uppercase tracking-wider text-dark-400">
              <th class="py-4 px-6 w-1/4">Specification</th>
              <th class="py-4 px-6 w-3/8 text-white font-semibold">
                <div class="flex items-center gap-2">
                  <span class="w-2 h-2 rounded-full bg-brand-cyan"></span>
                  <span>{toolA.name}</span>
                </div>
              </th>
              <th class="py-4 px-6 w-3/8 text-white font-semibold">
                <div class="flex items-center gap-2">
                  <span class="w-2 h-2 rounded-full bg-brand-violet"></span>
                  <span>{toolB.name}</span>
                </div>
              </th>
            </tr>
          </thead>
          <tbody class="divide-y divide-dark-800 text-sm">
            <!-- Category -->
            <tr class="hover:bg-dark-850/40 transition-colors">
              <td class="py-4 px-6 text-dark-400 font-medium">Category</td>
              <td class="py-4 px-6 text-white font-mono text-xs">{toolA.category}</td>
              <td class="py-4 px-6 text-white font-mono text-xs">{toolB.category}</td>
            </tr>

            <!-- Tagline -->
            <tr class="hover:bg-dark-850/40 transition-colors">
              <td class="py-4 px-6 text-dark-400 font-medium">Core Positioning</td>
              <td class="py-4 px-6 text-dark-300 text-xs leading-relaxed">{toolA.tagline}</td>
              <td class="py-4 px-6 text-dark-300 text-xs leading-relaxed">{toolB.tagline}</td>
            </tr>

            <!-- Pricing Model -->
            <tr class="hover:bg-dark-850/40 transition-colors">
              <td class="py-4 px-6 text-dark-400 font-medium">Pricing Model</td>
              <td class="py-4 px-6">
                <span class={`inline-block px-2.5 py-1 rounded text-xs font-mono font-medium ${
                  toolA.pricing_model === 'Free & Open Source'
                    ? 'bg-brand-emerald/10 text-brand-emerald border border-brand-emerald/30'
                    : toolA.pricing_model === 'Freemium'
                    ? 'bg-brand-indigo/10 text-brand-indigo border border-brand-indigo/30'
                    : 'bg-dark-800 text-dark-300 border border-dark-700'
                }`}>
                  {toolA.pricing_model}
                </span>
              </td>
              <td class="py-4 px-6">
                <span class={`inline-block px-2.5 py-1 rounded text-xs font-mono font-medium ${
                  toolB.pricing_model === 'Free & Open Source'
                    ? 'bg-brand-emerald/10 text-brand-emerald border border-brand-emerald/30'
                    : toolB.pricing_model === 'Freemium'
                    ? 'bg-brand-indigo/10 text-brand-indigo border border-brand-indigo/30'
                    : 'bg-dark-800 text-dark-300 border border-dark-700'
                }`}>
                  {toolB.pricing_model}
                </span>
              </td>
            </tr>

            <!-- Starting Price -->
            <tr class="hover:bg-dark-850/40 transition-colors">
              <td class="py-4 px-6 text-dark-400 font-medium">Starting Price</td>
              <td class="py-4 px-6 text-lg font-bold font-mono text-white">
                {toolA.starting_price}
              </td>
              <td class="py-4 px-6 text-lg font-bold font-mono text-white">
                {toolB.starting_price}
              </td>
            </tr>

            <!-- Free Tier / Trial -->
            <tr class="hover:bg-dark-850/40 transition-colors">
              <td class="py-4 px-6 text-dark-400 font-medium">Free Tier Available</td>
              <td class="py-4 px-6">
                {toolA.free_tier ? (
                  <span class="inline-flex items-center gap-1.5 text-xs font-mono text-brand-emerald font-semibold">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
                    Yes (Free Quota)
                  </span>
                ) : (
                  <span class="inline-flex items-center gap-1.5 text-xs font-mono text-dark-500">
                    <svg class="w-4 h-4 text-dark-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M6 18L18 6M6 6l12 12"/></svg>
                    Paid Only
                  </span>
                )}
              </td>
              <td class="py-4 px-6">
                {toolB.free_tier ? (
                  <span class="inline-flex items-center gap-1.5 text-xs font-mono text-brand-emerald font-semibold">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
                    Yes (Free Quota)
                  </span>
                ) : (
                  <span class="inline-flex items-center gap-1.5 text-xs font-mono text-dark-500">
                    <svg class="w-4 h-4 text-dark-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M6 18L18 6M6 6l12 12"/></svg>
                    Paid Only
                  </span>
                )}
              </td>
            </tr>

            <!-- Ideal Audience -->
            <tr class="hover:bg-dark-850/40 transition-colors">
              <td class="py-4 px-6 text-dark-400 font-medium">Best For</td>
              <td class="py-4 px-6 text-dark-300 text-xs leading-relaxed">{toolA.best_for}</td>
              <td class="py-4 px-6 text-dark-300 text-xs leading-relaxed">{toolB.best_for}</td>
            </tr>

            <!-- Supported Platforms -->
            <tr class="hover:bg-dark-850/40 transition-colors">
              <td class="py-4 px-6 text-dark-400 font-medium">Platforms</td>
              <td class="py-4 px-6">
                <div class="flex flex-wrap gap-1.5">
                  {toolA.supported_platforms.map((p) => (
                    <span class="px-2 py-0.5 rounded bg-dark-800 text-dark-300 text-[11px] font-mono border border-dark-700">
                      {p}
                    </span>
                  ))}
                </div>
              </td>
              <td class="py-4 px-6">
                <div class="flex flex-wrap gap-1.5">
                  {toolB.supported_platforms.map((p) => (
                    <span class="px-2 py-0.5 rounded bg-dark-800 text-dark-300 text-[11px] font-mono border border-dark-700">
                      {p}
                    </span>
                  ))}
                </div>
              </td>
            </tr>

            <!-- Key Features -->
            <tr class="hover:bg-dark-850/40 transition-colors">
              <td class="py-4 px-6 text-dark-400 font-medium align-top">Key Features</td>
              <td class="py-4 px-6">
                <ul class="space-y-2 text-xs text-dark-300">
                  {toolA.key_features.map((feature) => (
                    <li class="flex items-start gap-2">
                      <span class="text-brand-cyan shrink-0 mt-0.5">•</span>
                      <span>{feature}</span>
                    </li>
                  ))}
                </ul>
              </td>
              <td class="py-4 px-6">
                <ul class="space-y-2 text-xs text-dark-300">
                  {toolB.key_features.map((feature) => (
                    <li class="flex items-start gap-2">
                      <span class="text-brand-violet shrink-0 mt-0.5">•</span>
                      <span>{feature}</span>
                    </li>
                  ))}
                </ul>
              </td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>

    <!-- 4. Pros & Cons Duel Grid -->
    <section class="mb-14">
      <div class="mb-6">
        <h2 class="text-xl sm:text-2xl font-bold text-white tracking-tight">Pros & Cons Breakdown</h2>
        <p class="text-xs sm:text-sm text-dark-400">Objective strengths and potential limitations of each tool</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <!-- Tool A Pros & Cons -->
        <div class="rounded-2xl border border-dark-800 bg-dark-900/80 p-6 shadow-xl relative overflow-hidden flex flex-col justify-between">
          <div class="absolute top-0 left-0 right-0 h-1 bg-gradient-to-r from-brand-cyan to-brand-indigo"></div>
          <div>
            <div class="flex items-center justify-between mb-4">
              <h3 class="text-lg font-bold text-white flex items-center gap-2">
                <span>{toolA.name}</span>
                <span class="text-xs font-mono text-dark-500 font-normal">({toolA.pricing_model})</span>
              </h3>
              <span class="text-xs font-mono text-brand-cyan font-bold">{toolA.starting_price}</span>
            </div>

            <!-- Pros -->
            <div class="mb-6">
              <h4 class="text-xs font-mono uppercase tracking-wider text-brand-emerald font-bold mb-3 flex items-center gap-1.5">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                Core Advantages
              </h4>
              <ul class="space-y-2.5">
                {toolA.pros.map((pro) => (
                  <li class="flex items-start gap-2.5 text-xs sm:text-sm text-dark-300">
                    <span class="w-4 h-4 rounded-full bg-brand-emerald/10 text-brand-emerald flex items-center justify-center shrink-0 mt-0.5 text-[10px] font-bold">✓</span>
                    <span>{pro}</span>
                  </li>
                ))}
              </ul>
            </div>

            <!-- Cons -->
            <div class="mb-6">
              <h4 class="text-xs font-mono uppercase tracking-wider text-brand-rose font-bold mb-3 flex items-center gap-1.5">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>
                Known Limitations
              </h4>
              <ul class="space-y-2.5">
                {toolA.cons.map((con) => (
                  <li class="flex items-start gap-2.5 text-xs sm:text-sm text-dark-400">
                    <span class="w-4 h-4 rounded-full bg-brand-rose/10 text-brand-rose flex items-center justify-center shrink-0 mt-0.5 text-[10px] font-bold">✕</span>
                    <span>{con}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>

          <a
            href={toolA.affiliate_url}
            target="_blank"
            rel="noopener noreferrer"
            class="mt-4 w-full py-2.5 px-4 rounded-xl bg-dark-800 hover:bg-brand-cyan/20 text-white hover:text-brand-cyan border border-dark-700 hover:border-brand-cyan/50 text-xs font-semibold font-mono text-center flex items-center justify-center gap-2 transition-all group"
          >
            <span>Explore {toolA.name}</span>
            <svg class="w-3.5 h-3.5 group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
            </svg>
          </a>
        </div>

        <!-- Tool B Pros & Cons -->
        <div class="rounded-2xl border border-dark-800 bg-dark-900/80 p-6 shadow-xl relative overflow-hidden flex flex-col justify-between">
          <div class="absolute top-0 left-0 right-0 h-1 bg-gradient-to-r from-brand-violet to-brand-rose"></div>
          <div>
            <div class="flex items-center justify-between mb-4">
              <h3 class="text-lg font-bold text-white flex items-center gap-2">
                <span>{toolB.name}</span>
                <span class="text-xs font-mono text-dark-500 font-normal">({toolB.pricing_model})</span>
              </h3>
              <span class="text-xs font-mono text-brand-violet font-bold">{toolB.starting_price}</span>
            </div>

            <!-- Pros -->
            <div class="mb-6">
              <h4 class="text-xs font-mono uppercase tracking-wider text-brand-emerald font-bold mb-3 flex items-center gap-1.5">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                Core Advantages
              </h4>
              <ul class="space-y-2.5">
                {toolB.pros.map((pro) => (
                  <li class="flex items-start gap-2.5 text-xs sm:text-sm text-dark-300">
                    <span class="w-4 h-4 rounded-full bg-brand-emerald/10 text-brand-emerald flex items-center justify-center shrink-0 mt-0.5 text-[10px] font-bold">✓</span>
                    <span>{pro}</span>
                  </li>
                ))}
              </ul>
            </div>

            <!-- Cons -->
            <div class="mb-6">
              <h4 class="text-xs font-mono uppercase tracking-wider text-brand-rose font-bold mb-3 flex items-center gap-1.5">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>
                Known Limitations
              </h4>
              <ul class="space-y-2.5">
                {toolB.cons.map((con) => (
                  <li class="flex items-start gap-2.5 text-xs sm:text-sm text-dark-400">
                    <span class="w-4 h-4 rounded-full bg-brand-rose/10 text-brand-rose flex items-center justify-center shrink-0 mt-0.5 text-[10px] font-bold">✕</span>
                    <span>{con}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>

          <a
            href={toolB.affiliate_url}
            target="_blank"
            rel="noopener noreferrer"
            class="mt-4 w-full py-2.5 px-4 rounded-xl bg-dark-800 hover:bg-brand-violet/20 text-white hover:text-brand-violet border border-dark-700 hover:border-brand-violet/50 text-xs font-semibold font-mono text-center flex items-center justify-center gap-2 transition-all group"
          >
            <span>Explore {toolB.name}</span>
            <svg class="w-3.5 h-3.5 group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
            </svg>
          </a>
        </div>
      </div>
    </section>

    <!-- 5. High-Conversion Dual CTA Box -->
    <section class="mb-14">
      <div class="p-8 rounded-3xl bg-gradient-to-b from-dark-900 via-dark-850 to-dark-950 border border-dark-750 shadow-2xl text-center">
        <h2 class="text-2xl sm:text-3xl font-bold text-white tracking-tight mb-2">
          Ready to Test Your Stack?
        </h2>
        <p class="text-sm text-dark-400 max-w-xl mx-auto mb-8">
          Both tools offer distinct capabilities for different engineering and creative workflows. Try them directly or integrate their APIs.
        </p>

        <div class="flex flex-col sm:flex-row items-center justify-center gap-4 max-w-md mx-auto">
          <a
            href={toolA.affiliate_url}
            target="_blank"
            rel="noopener noreferrer"
            class="w-full sm:w-auto flex-1 py-3.5 px-6 rounded-xl bg-gradient-to-r from-brand-indigo to-brand-cyan text-white font-semibold text-sm shadow-lg shadow-brand-indigo/25 hover:shadow-brand-indigo/40 hover:-translate-y-0.5 transition-all flex items-center justify-center gap-2"
          >
            <span>Get Started with {toolA.name}</span>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
          </a>

          <a
            href={toolB.affiliate_url}
            target="_blank"
            rel="noopener noreferrer"
            class="w-full sm:w-auto flex-1 py-3.5 px-6 rounded-xl bg-dark-800 hover:bg-dark-750 text-white border border-dark-700 hover:border-dark-600 font-semibold text-sm hover:-translate-y-0.5 transition-all flex items-center justify-center gap-2"
          >
            <span>Visit {toolB.name}</span>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
          </a>
        </div>
      </div>
    </section>

    <!-- 6. Related Category Comparisons (pSEO Internal Linking Mesh) -->
    {relatedTools.length > 0 && (
      <section class="border-t border-dark-800/80 pt-10">
        <h3 class="text-sm font-mono uppercase tracking-wider text-dark-400 font-semibold mb-4">
          More {category} Comparisons
        </h3>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
          {relatedTools.slice(0, 6).map((other) => {
            const [first, second] = [toolA, other].sort((a, b) => a.slug.localeCompare(b.slug));
            const otherSlug = `${first.slug}-vs-${second.slug}`;
            return (
              <a
                href={`/compare/${otherSlug}`}
                class="p-3.5 rounded-xl bg-dark-900/60 border border-dark-800 hover:border-brand-indigo/40 hover:bg-dark-850/70 transition-all flex items-center justify-between group text-xs"
              >
                <span class="text-dark-300 group-hover:text-white font-medium">
                  {first.name} <span class="text-dark-500">vs</span> {second.name}
                </span>
                <span class="text-dark-500 group-hover:text-brand-cyan transition-colors">&rarr;</span>
              </a>
            );
          })}
        </div>
      </section>
    )}

  </div>
</Layout>
