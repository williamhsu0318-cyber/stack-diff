---
import Layout from '../layouts/Layout.astro';
import toolsData from '../../data/tools.json';

interface ToolItem {
  id: string;
  name: string;
  slug: string;
  category: string;
  tagline: string;
  pricing_model: string;
  starting_price: string;
  free_tier: boolean;
  best_for: string;
  key_features: string[];
  pros: string[];
  cons: string[];
  supported_platforms: string[];
  affiliate_url: string;
}

const tools = toolsData as ToolItem[];

// Group tools by category
const categoryMap = new Map<string, ToolItem[]>();
for (const tool of tools) {
  if (!categoryMap.has(tool.category)) {
    categoryMap.set(tool.category, []);
  }
  categoryMap.get(tool.category)!.push(tool);
}

// Generate all valid same-category pairwise comparisons
interface ComparisonPair {
  slug: string;
  toolA: ToolItem;
  toolB: ToolItem;
  category: string;
}

const allComparisons: ComparisonPair[] = [];

for (const [category, groupTools] of categoryMap.entries()) {
  if (groupTools.length < 2) continue;

  for (let i = 0; i < groupTools.length; i++) {
    for (let j = i + 1; j < groupTools.length; j++) {
      const [toolA, toolB] = [groupTools[i], groupTools[j]].sort((a, b) =>
        a.slug.localeCompare(b.slug)
      );
      const slug = `${toolA.slug}-vs-${toolB.slug}`;
      allComparisons.push({
        slug,
        toolA,
        toolB,
        category,
      });
    }
  }
}

// Category meta list
const categoriesList = Array.from(categoryMap.entries()).map(([name, items]) => ({
  name,
  count: items.length,
  diffCount: (items.length * (items.length - 1)) / 2,
}));

const pageTitle = "StackDiff - Diff Any AI Stack. Side-by-Side AI Tool Comparisons";
const pageDescription = "Objective, data-driven AI tool specifications and pairwise comparison matrices. Compare pricing, free tiers, and capabilities across top AI tools.";
---

<Layout title={pageTitle} description={pageDescription}>
  <!-- 1. Compact Hero Section (Information-dense, zero neon clutter) -->
  <section class="max-w-5xl mx-auto px-4 sm:px-6 pt-10 pb-8 text-center sm:text-left">
    <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-6 pb-8 border-b border-zinc-800">
      <div>
        <div class="inline-flex items-center gap-2 px-2.5 py-1 rounded bg-zinc-900 border border-zinc-800 text-xs font-mono text-zinc-400 mb-3">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
          <span>Engine v2026.1</span>
          <span class="text-zinc-700">•</span>
          <span>{allComparisons.length} Matrices Indexed</span>
        </div>
        <h1 class="text-3xl sm:text-4xl font-bold text-white tracking-tight leading-tight">
          Diff Any AI Stack.
        </h1>
        <p class="text-xs sm:text-sm text-zinc-400 mt-2 max-w-xl leading-relaxed">
          Objective, side-by-side technical specifications, commercial tiers, and architecture constraints. Zero marketing fluff.
        </p>
      </div>

      <!-- Quick Metrics Strip -->
      <div class="flex items-center justify-center sm:justify-end gap-3 text-left font-mono">
        <div class="px-3 py-2 rounded bg-[#121215] border border-zinc-800">
          <div class="text-sm font-bold text-white">20</div>
          <div class="text-[10px] text-zinc-500 uppercase">Tools</div>
        </div>
        <div class="px-3 py-2 rounded bg-[#121215] border border-zinc-800">
          <div class="text-sm font-bold text-white">{allComparisons.length}</div>
          <div class="text-[10px] text-zinc-500 uppercase">Diffs</div>
        </div>
        <div class="px-3 py-2 rounded bg-[#121215] border border-zinc-800">
          <div class="text-sm font-bold text-emerald-400">100%</div>
          <div class="text-[10px] text-zinc-500 uppercase">Verified</div>
        </div>
      </div>
    </div>
  </section>

  <!-- 2. Categories Filter Badges -->
  <section id="categories" class="max-w-5xl mx-auto px-4 sm:px-6 py-6">
    <div class="flex items-center justify-between mb-3">
      <h2 class="text-xs font-mono uppercase font-bold text-zinc-400 tracking-wider">
        Taxonomies
      </h2>
      <span class="text-[11px] font-mono text-zinc-500">{categoriesList.length} Categories</span>
    </div>

    <div class="flex flex-wrap gap-2">
      {categoriesList.map((cat) => (
        <a
          href={`#category-${cat.name.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`}
          class="px-3 py-1.5 rounded bg-zinc-900/80 border border-zinc-800 hover:border-zinc-700 hover:bg-zinc-850 transition-colors text-xs flex items-center gap-2 group"
        >
          <span class="text-zinc-200 group-hover:text-white font-medium">{cat.name}</span>
          <span class="text-[10px] font-mono text-zinc-500 bg-zinc-800 px-1.5 py-0.2 rounded">
            {cat.diffCount}
          </span>
        </a>
      ))}
    </div>
  </section>

  <!-- 3. Popular Comparisons (High-Density Grid, No Overlap) -->
  <section id="popular-comparisons" class="max-w-5xl mx-auto px-4 sm:px-6 py-6">
    <div class="space-y-10">
      {Array.from(categoryMap.entries()).map(([catName, catTools]) => {
        const catComparisons = allComparisons.filter((c) => c.category === catName);
        if (catComparisons.length === 0) return null;

        return (
          <div id={`category-${catName.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`} class="scroll-mt-20">
            <!-- Category Subheader -->
            <div class="flex items-center justify-between pb-2 mb-3 border-b border-zinc-800/80">
              <h3 class="text-xs font-mono font-semibold text-zinc-300 uppercase tracking-wider flex items-center gap-2">
                <span class="w-1.5 h-1.5 rounded-full bg-zinc-500"></span>
                <span>{catName}</span>
              </h3>
              <span class="text-[11px] font-mono text-zinc-500">
                {catComparisons.length} {catComparisons.length === 1 ? 'pair' : 'pairs'}
              </span>
            </div>

            <!-- Cards Grid -->
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
              {catComparisons.map((pair) => (
                <a
                  href={`/compare/${pair.slug}`}
                  class="group p-3.5 rounded-lg bg-[#121215] border border-zinc-800/90 hover:border-zinc-700 hover:bg-[#15151a] transition-all flex flex-col justify-between overflow-hidden"
                >
                  <div class="min-w-0">
                    <!-- Top Info Row -->
                    <div class="flex items-center justify-between gap-2 mb-2">
                      <span class="text-[10px] font-mono text-zinc-500 uppercase tracking-wider truncate">
                        {pair.category}
                      </span>
                      <span class="text-xs text-zinc-500 group-hover:text-zinc-300 font-mono transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5">
                        ↗
                      </span>
                    </div>

                    <!-- Duel Heading (Safe truncation) -->
                    <h4 class="text-sm font-bold text-zinc-100 group-hover:text-white transition-colors truncate mb-2">
                      {pair.toolA.name} <span class="text-zinc-500 font-normal font-mono text-xs">vs</span> {pair.toolB.name}
                    </h4>

                    <!-- Price Spec Pill -->
                    <div class="flex items-center gap-2 text-[11px] font-mono text-zinc-400 mb-2.5 bg-zinc-900/90 px-2 py-1 rounded border border-zinc-800/80">
                      <span class="text-zinc-200 font-semibold truncate">{pair.toolA.starting_price}</span>
                      <span class="text-zinc-600">vs</span>
                      <span class="text-zinc-200 font-semibold truncate">{pair.toolB.starting_price}</span>
                    </div>

                    <!-- Concise Description (Strict line-clamp-2) -->
                    <p class="text-[11px] text-zinc-400 line-clamp-2 leading-relaxed mb-3 overflow-hidden">
                      {pair.toolA.best_for} vs {pair.toolB.best_for}.
                    </p>
                  </div>

                  <!-- Footer Status -->
                  <div class="pt-2 border-t border-zinc-800/60 flex items-center justify-between text-[10px] font-mono text-zinc-500">
                    <span>{pair.toolA.free_tier ? 'Free tier' : 'Paid'} / {pair.toolB.free_tier ? 'Free tier' : 'Paid'}</span>
                    <span class="text-zinc-400 group-hover:text-zinc-200">View Diff &rarr;</span>
                  </div>
                </a>
              ))}
            </div>
          </div>
        );
      })}
    </div>
  </section>
</Layout>
